local function GetCowPen()
    local exact=workspace:FindFirstChild("KandangSapi_2919114494",true)
    if exact then return exact end
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj.Name:match("^KandangSapi_") then return obj end
    end
end
local function GetCowPrompt(name)
    local pen=GetCowPen()
    local p=pen and pen:FindFirstChild(name,true)
    return p and p:IsA("ProximityPrompt") and p or nil
end
local function TriggerPrompt(prompt)
    if not prompt or not prompt.Parent then return false,"Prompt tidak ditemukan" end
    if not prompt.Enabled then return false,"Prompt belum aktif" end
    if typeof(fireproximityprompt)=="function" then
        local ok=pcall(function() fireproximityprompt(prompt,prompt.HoldDuration) end)
        if ok then return true end
    end
    local ok,err=pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(prompt.HoldDuration,0)+0.1)
        prompt:InputHoldEnd()
    end)
    return ok,ok and nil or tostring(err)
end
local function GetPromptPosition(prompt)
    if not prompt or not prompt.Parent then return nil end
    local parent=prompt.Parent
    if parent:IsA("Attachment") then return parent.WorldPosition end
    if parent:IsA("BasePart") then return parent.Position end
    if parent:IsA("Model") then return parent:GetPivot().Position end
    local part=parent:FindFirstAncestorWhichIsA("BasePart")
    return part and part.Position or nil
end
local function WaitForCowTeleport()
    while cowTeleporting and alive do task.wait(0.1) end
    return alive
end
local function TeleportToPrompt(prompt)
    local character=Player.Character
    local root=character and character:FindFirstChild("HumanoidRootPart")
    if not character or not root then return nil,nil,"Karakter tidak ditemukan" end
    local position=GetPromptPosition(prompt)
    if not position then return nil,nil,"Posisi prompt tidak terbaca" end
    local saved=root.CFrame
    character:PivotTo(CFrame.new(position+Vector3.new(0,3,0)))
    task.wait(1)
    return saved,character,nil
end
local function ReturnToSavedPosition(saved)
    if not saved then return end
    local character=Player.Character
    if character then pcall(function() character:PivotTo(saved) end) end
    task.wait(1)
end
local function GetFeedAmount()
    local pen=GetCowPen()
    if not pen then return nil end
    local fallback
    for _,obj in ipairs(pen:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local t=GetText(obj); local upper=t:upper()
            local current,total=t:match("(%d+)%s*/%s*(%d+)")
            if current and tonumber(total)==MAX_PAKAN then
                current=tonumber(current)
                if upper:find("PAKAN",1,true) or upper:find("FEED",1,true) then return current end
                if not upper:find("SUSU",1,true) and not upper:find("MILK",1,true) and fallback==nil then fallback=current end
            end
        end
    end
    return fallback
end
local function GetMilkAmount()
    local pen=GetCowPen()
    if not pen then return nil end
    for _,obj in ipairs(pen:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local t=GetText(obj); local upper=t:upper()
            if upper:find("SUSU",1,true) or upper:find("MILK",1,true) then
                local current,total=t:match("(%d+)%s*/%s*(%d+)")
                if current and tonumber(total)==MAX_SUSU then return tonumber(current) end
                local parent=obj.Parent
                if parent then
                    for _,child in ipairs(parent:GetDescendants()) do
                        if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                            local n,t2=GetText(child):match("(%d+)%s*/%s*(%d+)")
                            if n and tonumber(t2)==MAX_SUSU then return tonumber(n) end
                        end
                    end
                end
            end
        end
    end
end
local function FeedAtCow()
    if pakanBusy or susuBusy or cowTeleporting then return end
    pakanBusy=true; cowTeleporting=true
    local saved,teleported,finished,failureReason=nil,false,false,nil
    local ok,err=pcall(function()
        local prompt=GetCowPrompt("PakanPrompt")
        if not prompt then failureReason="PakanPrompt tidak ditemukan"; return end
        SetStatus("Pakan","Menyimpan posisi...")
        local pos,character,reason=TeleportToPrompt(prompt)
        if not pos then failureReason=reason; return end
        saved=pos; teleported=true
        local start=os.clock()
        while alive and F.Pakan and os.clock()-start<75 do
            local amount=GetFeedAmount()
            if amount==nil then failureReason="Angka pakan tidak terbaca"; break end
            if amount>=MAX_PAKAN then finished=true; break end
            prompt=GetCowPrompt("PakanPrompt")
            if not prompt then failureReason="PakanPrompt hilang"; break end
            if prompt.Enabled then
                TriggerPrompt(prompt); SetStatus("Pakan","Mengisi pakan: "..amount.."/60")
            else SetStatus("Pakan","Menunggu prompt: "..amount.."/60") end
            task.wait(1.5)
        end
        if not finished and not failureReason then failureReason="Waktu pengisian habis" end
    end)
    if not ok then failureReason="Error: "..tostring(err) end
    if teleported then SetStatus("Pakan","Kembali ke posisi awal..."); ReturnToSavedPosition(saved) end
    cowTeleporting=false; pakanBusy=false
    if finished then SetStatus("Pakan","Penuh 60/60 - kembali")
    elseif failureReason then SetStatus("Pakan",failureReason.." - posisi dikembalikan")
    else SetStatus("Pakan","Selesai") end
end
local function MilkAtCow()
    if susuBusy or pakanBusy or cowTeleporting then return end
    susuBusy=true; cowTeleporting=true
    local saved,teleported,collected,failureReason=nil,false,false,nil
    local ok,err=pcall(function()
        local prompt=GetCowPrompt("AmbilPrompt")
        if not prompt then failureReason="AmbilPrompt tidak ditemukan"; return end
        SetStatus("Susu","Menyimpan posisi...")
        local pos,character,reason=TeleportToPrompt(prompt)
        if not pos then failureReason=reason; return end
        saved=pos; teleported=true
        local startAmount=GetMilkAmount()
        if startAmount==nil then failureReason="Angka susu tidak terbaca"; return end
        local start=os.clock()
        while alive and F.Susu and os.clock()-start<30 do
            local amount=GetMilkAmount()
            if amount==nil then failureReason="Angka susu tidak terbaca"; break end
            if amount<MIN_SUSU or amount<startAmount then collected=true; break end
            prompt=GetCowPrompt("AmbilPrompt")
            if not prompt then failureReason="AmbilPrompt hilang"; break end
            if prompt.Enabled then
                TriggerPrompt(prompt); SetStatus("Susu","Mengambil susu: "..amount.."/60")
            else SetStatus("Susu","Menunggu AmbilPrompt...") end
            task.wait(1.5)
        end
        if not collected and not failureReason then failureReason="Susu belum berubah" end
    end)
    if not ok then failureReason="Error: "..tostring(err) end
    if teleported then SetStatus("Susu","Kembali ke posisi awal..."); ReturnToSavedPosition(saved) end
    cowTeleporting=false; susuBusy=false
    if collected then SetStatus("Susu","Susu diambil - kembali ke posisi awal")
    elseif failureReason then SetStatus("Susu",failureReason.." - posisi dikembalikan")
    else SetStatus("Susu","Selesai") end
end

