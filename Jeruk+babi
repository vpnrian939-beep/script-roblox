local CameraConnection,CameraSaved
local CameraYaw,CameraDistance=0,18
local MIN_CAMERA_DISTANCE,MAX_CAMERA_DISTANCE=8,40
local ROTATE_SENSITIVITY,ZOOM_SENSITIVITY=0.006,0.04
local TouchPositions,TouchStartPositions={},{}
local LastPinchDistance,RotatingMouse
local CurrentPig,CurrentPigPrompt,PigReturnCFrame,PigCharacter
local CurrentPigStartedAt,NextPigAttempt=0,0

local function GetCamera() return workspace.CurrentCamera end
local function IsTouchOverGui(position)
    local ok,objects=pcall(function() return GuiService:GetGuiObjectsAtPosition(position.X,position.Y) end)
    if not ok then return false end
    for _,obj in ipairs(objects) do if obj:IsDescendantOf(ScreenGui) then return true end end
    return false
end
local function GetTwoTouchDistance()
    local positions={}
    for _,p in pairs(TouchPositions) do table.insert(positions,p) end
    if #positions<2 then return nil end
    return (positions[1]-positions[2]).Magnitude
end
local function StopTopCamera()
    if CameraConnection then CameraConnection:Disconnect(); CameraConnection=nil end
    local camera=GetCamera()
    if camera and CameraSaved then
        pcall(function()
            camera.CameraType=CameraSaved.Type
            camera.CameraSubject=CameraSaved.Subject
            camera.FieldOfView=CameraSaved.FOV
        end)
    end
    CameraSaved=nil; TouchPositions={}; TouchStartPositions={}
    LastPinchDistance=nil; RotatingMouse=false
end
local function StartTopCamera()
    StopTopCamera()
    local camera=GetCamera()
    local character,humanoid,root=GetCharacter()
    if not camera or not character then return end
    CameraSaved={Type=camera.CameraType,Subject=camera.CameraSubject,FOV=camera.FieldOfView}
    local look=root.CFrame.LookVector
    CameraYaw=math.atan2(look.X,-look.Z)
    CameraDistance=math.clamp((camera.CFrame.Position-root.Position).Magnitude,8,40)
    camera.CameraType=Enum.CameraType.Scriptable; camera.FieldOfView=65
    CameraConnection=RunService.RenderStepped:Connect(function()
        if not F.Farm or not CurrentPig then StopTopCamera(); return end
        local _,_,r=GetCharacter(); local cam=GetCamera()
        if not r or not cam then return end
        local focus=r.Position
        local forward=Vector3.new(math.sin(CameraYaw),0,-math.cos(CameraYaw))
        cam.CFrame=CFrame.lookAt(focus+Vector3.new(0,CameraDistance,0),focus,forward)
    end)
end
UIS.InputBegan:Connect(function(input)
    if not CameraConnection then return end
    if input.UserInputType==Enum.UserInputType.MouseButton2 then RotatingMouse=true; return end
    if input.UserInputType==Enum.UserInputType.Touch then
        TouchPositions[input]=input.Position; TouchStartPositions[input]=input.Position
        LastPinchDistance=GetTwoTouchDistance()
    end
end)
UIS.InputChanged:Connect(function(input)
    if not CameraConnection then return end
    if input.UserInputType==Enum.UserInputType.MouseMovement and RotatingMouse then
        CameraYaw=CameraYaw-input.Delta.X*ROTATE_SENSITIVITY; return
    end
    if input.UserInputType==Enum.UserInputType.MouseWheel then
        CameraDistance=math.clamp(CameraDistance-input.Position.Z*1.5,8,40); return
    end
    if input.UserInputType==Enum.UserInputType.Touch then
        local old=TouchPositions[input]; local new=input.Position
        if not old then return end
        TouchPositions[input]=new
        local pinch=GetTwoTouchDistance()
        if pinch then
            if LastPinchDistance then
                CameraDistance=math.clamp(CameraDistance-(pinch-LastPinchDistance)*ZOOM_SENSITIVITY,8,40)
            end
            LastPinchDistance=pinch
        else
            LastPinchDistance=nil
            local start=TouchStartPositions[input]
            local cam=GetCamera(); local viewport=cam and cam.ViewportSize
            if start and viewport and start.X>=viewport.X*0.45 and not IsTouchOverGui(start) then
                CameraYaw=CameraYaw-(new-old).X*ROTATE_SENSITIVITY
            end
        end
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton2 then RotatingMouse=false end
    if input.UserInputType==Enum.UserInputType.Touch then
        TouchPositions[input]=nil; TouchStartPositions[input]=nil
        LastPinchDistance=GetTwoTouchDistance()
    end
end)

