local function GetText(object)
    local ok,value=pcall(function() return object.Text end)
    return ok and typeof(value)=="string" and value or ""
end
local function IsVisible(object)
    if not object or not object:IsA("GuiObject") then return false end
    local current=object
    while current and current~=PlayerGui do
        if current:IsA("GuiObject") and not current.Visible then return false end
        current=current.Parent
    end
    return true
end
local function FindButton(object)
    local current=object
    for _=1,10 do
        if not current then break end
        if current:IsA("GuiButton") then return current end
        current=current.Parent
    end
end
local function FireButton(button)
    if not button or not button.Parent then return false end
    local fired=false
    pcall(function()
        if typeof(firesignal)=="function" then firesignal(button.Activated); fired=true end
    end)
    if not fired then pcall(function() button:Activate(); fired=true end) end
    return fired
end
local function GetRakGui() return PlayerGui:FindFirstChild("RakGui") end
local function GetRakMainFrame()
    local gui=GetRakGui()
    if not gui then return nil end
    if gui.Name=="MainFrame" then return gui end
    return gui:FindFirstChild("MainFrame",true)
end
local function RakTerbuka()
    local frame=GetRakMainFrame()
    return frame~=nil and frame:IsA("GuiObject") and frame.Visible
end
local function FindRakController()
    if typeof(getgc)~="function" then return nil,nil end
    local ok,objects=pcall(function() return getgc(true) end)
    if not ok or type(objects)~="table" then return nil,nil end
    local gui,frame=GetRakGui(),GetRakMainFrame()
    for _,object in ipairs(objects) do
        if type(object)=="table" then
            local hasGui,openFunction=false,nil
            for key,value in pairs(object) do
                if (gui and value==gui) or (frame and value==frame) then hasGui=true end
                if key=="Open" and type(value)=="function" then openFunction=value end
            end
            if hasGui and openFunction then return object,openFunction end
        end
    end
    return nil,nil
end
local function TryOpenController(controller,openFunction)
    if not openFunction then return false end
    pcall(function() openFunction() end); task.wait(0.2)
    if RakTerbuka() then return true end
    if controller then pcall(function() openFunction(controller) end) end
    task.wait(0.3)
    return RakTerbuka()
end
local function TryRakButtons(container)
    if not container then return false end
    for _,obj in ipairs(container:GetDescendants()) do
        if obj:IsA("GuiButton") and IsVisible(obj) then
            local name=obj.Name:lower()
            if name=="rak" or name=="rakkios" or name=="rak_kios" then
                FireButton(obj); task.wait(0.35)
                if RakTerbuka() then return true end
            end
        end
    end
    return false
end
local function OpenRak()
    if RakTerbuka() then return true end
    SetStatus("Restock","Membuka Rak Kios")
    local controller,fn=FindRakController()
    if controller and fn and TryOpenController(controller,fn) then return true end
    local gui=GetRakGui()
    if gui and TryRakButtons(gui) then return true end
    if TryRakButtons(PlayerGui) then return true end
    task.wait(0.25)
    controller,fn=FindRakController()
    if controller and fn then return TryOpenController(controller,fn) end
    return RakTerbuka()
end
local function FindIsi()
    local gui=GetRakGui()
    if not gui then return nil end
    for _,obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("GuiButton") and IsVisible(obj) and obj.Name:lower()=="isi" then return obj end
    end
    for _,obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("GuiObject") and IsVisible(obj) then
            local t=GetText(obj):lower()
            if t:match("^%s*isi%s*%+") or t:match("^%s*isi%s*$") then
                local b=FindButton(obj)
                if b and IsVisible(b) then return b end
            end
        end
    end
end
local function ProcessRestock()
    if not F.Restock then return end
    if not RakTerbuka() and not OpenRak() then
        SetStatus("Restock","Rak belum terbuka; mencoba lagi"); return
    end
    local button=FindIsi()
    if not button then SetStatus("Restock","Tombol Isi belum ditemukan"); return end
    SetStatus("Restock",FireButton(button) and "Input Isi dikirim" or "Gagal mengaktifkan tombol Isi")
    task.wait(0.8)
end

