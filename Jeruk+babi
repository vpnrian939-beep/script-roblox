local function GetCharacter()
    local c=Player.Character
    if not c then return nil end
    local h=c:FindFirstChildOfClass("Humanoid")
    local r=c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health<=0 then return nil end
    return c,h,r
end
local function GetHumanoid()
    local h=Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
    return h
end
local function FindTool(keyword)
    local target=keyword:gsub("%s+",""):lower()
    for _,container in ipairs({Player:FindFirstChildOfClass("Backpack"),Player.Character}) do
        if container then
            for _,tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and tool.Name:gsub("%s+",""):lower():find(target,1,true) then
                    return tool
                end
            end
        end
    end
end
local function Equip(tool)
    local h=GetHumanoid()
    if not h or not tool then return false end
    h:EquipTool(tool); task.wait(0.7)
    return tool.Parent==Player.Character
end
local function GetRemoteFolder()
    local module=RS:FindFirstChild("RemoteRegistry")
    if not module then return nil end
    local ok,registry=pcall(require,module)
    if not ok then return nil end
    local success,folder=pcall(function() return registry.folder("Remotes") end)
    return success and folder or nil
end
local function GetRemote(name,timeout)
    local folder=GetRemoteFolder()
    if not folder then return nil end
    return folder:WaitForChild(name,timeout or 15)
end

