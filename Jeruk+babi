local ShopBuyRemote,OrangeSeedItem
local function LoadOrangeShop()
    local module=RS:FindFirstChild("ShopConfig")
    if not module then SetStatus("Beli","ShopConfig tidak ditemukan"); return false end
    local ok,config=pcall(require,module)
    if not ok then SetStatus("Beli","Gagal membaca ShopConfig"); return false end
    OrangeSeedItem=config.Get("BibitJeruk")
    if not OrangeSeedItem then SetStatus("Beli","Data bibit tidak ditemukan"); return false end
    if OrangeSeedItem.ItemId~="BibitJeruk" or OrangeSeedItem.PlantKey~="Jeruk"
    or OrangeSeedItem.Category~="Bibit" then
        SetStatus("Beli","Data bibit tidak sesuai"); return false
    end
    local folder=GetRemoteFolder()
    if not folder then return false end
    ShopBuyRemote=folder:FindFirstChild("ShopBuy")
    return ShopBuyRemote~=nil and ShopBuyRemote:IsA("RemoteFunction")
end
local function GetSeedStock()
    local total=0
    for _,container in ipairs({Player.Backpack,Player.Character}) do
        if container then
            for _,tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") then
                    local name=tool.Name:gsub("%s+",""):lower()
                    if name:find("bibitjeruk",1,true) then
                        local amount=tool:GetAttribute("Amount") or tool:GetAttribute("Count")
                            or tool:GetAttribute("Quantity") or tool:GetAttribute("Stack")
                        total=total+(typeof(amount)=="number" and amount or tonumber(name:match("[xX](%d+)")) or 1)
                    end
                end
            end
        end
    end
    return total
end
local function BuyOrangeSeed()
    if buyBusy then return end
    buyBusy=true
    local ok,err=pcall(function()
        local stock=GetSeedStock()
        SetStatus("Beli","Stok terbaca: "..stock)
        if stock>=MIN_SEED_STOCK then SetStatus("Beli","Stok masih cukup"); return end
        if not LoadOrangeShop() then SetStatus("Beli","Gagal memuat toko"); return end
        SetStatus("Beli","Membeli 120 bibit jeruk...")
        local result=ShopBuyRemote:InvokeServer(OrangeSeedItem.ItemId,BUY_AMOUNT)
        if type(result)=="table" and result.ok==false then
            SetStatus("Beli","Pembelian ditolak server")
        else SetStatus("Beli","Permintaan pembelian dikirim") end
    end)
    if not ok then SetStatus("Beli","Error: "..tostring(err)) end
    buyBusy=false
end

