local function GetPart(model)
    if not model then return nil end
    if model:IsA("BasePart") then return model end
    if model:IsA("Model") then
        if model.PrimaryPart then return model.PrimaryPart end
        for _,obj in ipairs(model:GetDescendants()) do if obj:IsA("BasePart") then return obj end end
    end
end
local function GetPromptPart(prompt,fallback)
    local current=prompt
    while current and current~=workspace do
        if current:IsA("BasePart") then return current end
        current=current.Parent
    end
    return fallback
end
local function HoldPrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local began=false
    local ok=pcall(function()
        prompt:InputHoldBegin(); began=true
        task.wait(math.max(HOLD_TIME,prompt.HoldDuration or 0)+0.05)
    end)
    if began then pcall(function() prompt:InputHoldEnd() end) end
    return ok
end
local function TeleportTo(root,target,distance,height)
    if not root or not target or not target.Parent then return false end
    local direction=root.Position-target.Position
    if direction.Magnitude<0.01 then direction=Vector3.new(0,0,1) end
    direction=direction.Unit
    local destination=target.Position+direction*(distance or 1.5)+Vector3.new(0,height or 0.5,0)
    root.CFrame=CFrame.lookAt(destination,target.Position)
    root.AssemblyLinearVelocity=Vector3.zero
    root.AssemblyAngularVelocity=Vector3.zero
    return true
end
local function IsPigModel(model)
    if not model or not model:IsA("Model") then return false end
    local n=model.Name:lower()
    return n=="babi" or n:match("^babi[%s_%-]")~=nil
end
local function FindPigs()
    local pigs={}
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and IsPigModel(obj) and not obj.Name:lower():find("induk",1,true) then
            table.insert(pigs,obj)
        end
    end
    return pigs
end
local function IsReady(model)
    if not model or not model.Parent then return false end
    for _,obj in ipairs(model:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local t=GetText(obj):lower()
            if t:find("rawatan",1,true) then
                local n=t:match("rawatan[^%d]*(%d+)%s*%%")
                if tonumber(n)==100 then return true end
            end
        end
    end
    return false
end
local function FindCarry(model)
    if not model or not model.Parent then return nil end
    for _,obj in ipairs(model:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local t=((obj.ActionText or "").." "..(obj.ObjectText or "")):lower()
            if t:find("bawa",1,true) then return obj end
        end
    end
end
local RetryPigAt={}
local function CleanRetryData()
    for pig in pairs(RetryPigAt) do if not pig or not pig.Parent then RetryPigAt[pig]=nil end end
end
local function ChooseReadyPig(root)
    local nearest,bestDistance=nil,math.huge
    local now=os.clock()
    for _,pig in ipairs(FindPigs()) do
        if pig.Parent and IsReady(pig) and (RetryPigAt[pig] or 0)<=now then
            local prompt,part=FindCarry(pig),GetPart(pig)
            if prompt and prompt.Parent and prompt.Enabled and part then
                local d=(root.Position-part.Position).Magnitude
                if d<bestDistance then nearest,bestDistance=pig,d end
            end
        end
    end
    return nearest,bestDistance
end

