local function FindPalung()
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj.Name=="TempatMakan" and (obj:IsA("Model") or obj:IsA("BasePart")) then
            local part=GetPart(obj); if part then return obj,part end
        end
    end
end
local function GetPalungPrompt(model)
    if not model then return nil end
    for _,obj in ipairs(model:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local t=((obj.ActionText or "").." "..(obj.ObjectText or "")):lower()
            if t:find("palung",1,true) or t:find("sate kepiting",1,true) then return obj end
        end
    end
end
local function ReadAmount(prompt,model)
    local texts={}
    if prompt then table.insert(texts,(prompt.ActionText or "").." "..(prompt.ObjectText or "")) end
    if model then
        for _,obj in ipairs(model:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                local t=GetText(obj):lower()
                if t:find("sate kepiting",1,true) or t:find("pakan",1,true) then table.insert(texts,t) end
            end
        end
    end
    for _,raw in ipairs(texts) do
        local t=raw:lower()
        local n=t:match("sate kepiting%s*[x×]%s*(%d+)")
        if not n then n=t:match("[x×]%s*(%d+)") end
        if not n then n=t:match("pakan%s*:?%s*(%d+)") end
        if n then return tonumber(n) end
    end
end
local function EquipSate(character,humanoid)
    local tool=FindSate()
    if not tool then SetStatus("Farm","Sate Kepiting tidak ditemukan"); return false end
    if tool.Parent~=character then
        local ok=pcall(function() humanoid:EquipTool(tool) end)
        if not ok then SetStatus("Farm","Gagal equip Sate Kepiting"); return false end
        task.wait(0.2)
    end
    return true
end
local function FillPalung()
    if os.clock()<PalungNextAttempt then return end
    local character,humanoid,root=GetCharacter()
    if not character then SetStatus("Farm","Menunggu karakter"); return end
    local model,part=FindPalung()
    if not model or not part then SetStatus("Farm","TempatMakan tidak ditemukan"); return end
    local prompt=GetPalungPrompt(model)
    if not prompt then SetStatus("Farm","Prompt Palung tidak ditemukan"); return end
    local amount=ReadAmount(prompt,model)
    if not EquipSate(character,humanoid) then return end
    local target=GetPromptPart(prompt,part)
    if target and (root.Position-target.Position).Magnitude>(prompt.MaxActivationDistance or 8) then
        TeleportTo(root,target,3,2); task.wait(0.3)
    end
    if amount==nil then
        if PalungPendingRead then SetStatus("Farm","Menunggu angka pakan muncul"); PalungNextAttempt=os.clock()+1; return end
        SetStatus("Farm","Mencoba isi Palung")
        local success=HoldPrompt(prompt)
        PalungPendingRead=true; PalungNextAttempt=os.clock()+1
        if not success then SetStatus("Farm","Input Palung gagal") end
        return
    end
    PalungPendingRead=false
    if not PalungInitialized and amount>=TARGET_FOOD then
        PalungInitialized=true; SetStatus("Farm","Pengisian awal selesai"); return
    end
    if PalungInitialized and amount>=REFILL_AT then
        SetStatus("Farm","Pakan "..amount.."; menunggu di bawah 7"); return
    end
    if amount>=TARGET_FOOD then PalungInitialized=true; return end
    if not FindSate() then SetStatus("Farm","Sate Kepiting habis"); return end
    SetStatus("Farm","Mengisi Palung: "..amount.."/10")
    if HoldPrompt(prompt) then
        PalungPendingRead=true; PalungNextAttempt=os.clock()+0.8
    else
        SetStatus("Farm","Gagal menekan prompt Palung"); PalungNextAttempt=os.clock()+1
    end
end

local function ReturnFromPig()
    StopTopCamera()
    if PigReturnCFrame then
        local character,humanoid,root=GetCharacter()
        if character and character==PigCharacter then
            root.CFrame=PigReturnCFrame
            root.AssemblyLinearVelocity=Vector3.zero
            root.AssemblyAngularVelocity=Vector3.zero
        end
    end
    CurrentPig=nil; CurrentPigPrompt=nil; PigReturnCFrame=nil; PigCharacter=nil
    CurrentPigStartedAt=0; NextPigAttempt=0
    ApplySpeed()
end
local function StartPig(pig,prompt,part)
    local character,humanoid,root=GetCharacter()
    if not character or not pig or not prompt or not part then return false end
    if not pig.Parent or not prompt.Parent or not prompt.Enabled or not IsReady(pig) then return false end
    PigReturnCFrame=root.CFrame; PigCharacter=character
    CurrentPig=pig; CurrentPigPrompt=prompt; CurrentPigStartedAt=os.clock()
    local promptPart=GetPromptPart(prompt,part)
    if not promptPart or not promptPart.Parent then
        CurrentPig=nil; CurrentPigPrompt=nil; PigReturnCFrame=nil; PigCharacter=nil
        return false
    end
    TeleportTo(root,promptPart,1.5,0.5)
    task.wait(0.15)
    if not CurrentPig or not CurrentPig.Parent then
        RetryPigAt[pig]=os.clock()+PIG_RETRY_COOLDOWN; ReturnFromPig(); return false
    end
    StartTopCamera()
    SetStatus("Farm","Mengambil Babi 100%"); NextPigAttempt=0
    return true
end
local function CurrentTargetUnavailable()
    return not CurrentPig or not CurrentPig.Parent or not CurrentPigPrompt
        or not CurrentPigPrompt.Parent or not CurrentPigPrompt.Enabled
end
local function ProcessCurrentPig()
    if not CurrentPig then return end
    if not F.Farm then ReturnFromPig(); return end
    local character,humanoid,root=GetCharacter()
    if not character then SetStatus("Farm","Menunggu karakter"); return end
    if character~=PigCharacter then ReturnFromPig(); return end
    local pig,prompt=CurrentPig,CurrentPigPrompt
    if CurrentTargetUnavailable() then
        RetryPigAt[pig]=os.clock()+PIG_RETRY_COOLDOWN
        SetStatus("Farm","Target berubah; scan babi lain"); ReturnFromPig(); return
    end
    if not IsReady(pig) then
        RetryPigAt[pig]=os.clock()+PIG_RETRY_COOLDOWN
        SetStatus("Farm","Target bukan 100%; mencari target lain"); ReturnFromPig(); return
    end
    if os.clock()-CurrentPigStartedAt>=PIG_TARGET_TIMEOUT then
        RetryPigAt[pig]=os.clock()+PIG_RETRY_COOLDOWN
        SetStatus("Farm","Target timeout; scan ulang semua babi"); ReturnFromPig(); return
    end
    if os.clock()<NextPigAttempt then return end
    SetStatus("Farm","Mencoba mengambil babi")
    local success=HoldPrompt(prompt)
    task.wait(0.2)
    if CurrentPig~=pig then return end
    if CurrentTargetUnavailable() or not IsReady(pig) then
        RetryPigAt[pig]=os.clock()+PIG_RETRY_COOLDOWN
        SetStatus("Farm","Target selesai/berubah; scan babi berikutnya"); ReturnFromPig(); return
    end
    if os.clock()-CurrentPigStartedAt>=PIG_TARGET_TIMEOUT then
        RetryPigAt[pig]=os.clock()+PIG_RETRY_COOLDOWN
        SetStatus("Farm","Target terlalu lama; pindah target"); ReturnFromPig(); return
    end
    NextPigAttempt=os.clock()+PIG_ATTEMPT_INTERVAL
    SetStatus("Farm",success and "Menunggu hasil pengambilan" or "Input gagal; mencoba lagi")
end
local function FarmStep()
    if not F.Farm then
        if CurrentPig then ReturnFromPig() else StopTopCamera() end
        return
    end
    if CurrentPig then ProcessCurrentPig(); return end
    StopTopCamera()
    local character,humanoid,root=GetCharacter()
    if not character then SetStatus("Farm","Menunggu karakter"); return end
    CleanRetryData()
    local model,part=FindPalung()
    if not model or not part then SetStatus("Farm","Mencari TempatMakan"); return end
    local prompt=GetPalungPrompt(model)
    if not prompt then SetStatus("Farm","Mencari Prompt Palung"); return end
    local amount=ReadAmount(prompt,model)
    if not PalungInitialized then
        if amount==nil or amount<TARGET_FOOD then FillPalung(); return end
        PalungInitialized=true
    end
    if amount==nil then FillPalung(); return end
    if amount<REFILL_AT then FillPalung(); return end
    local pig=ChooseReadyPig(root)
    if not pig then
        local ready,waiting=0,0
        for _,candidate in ipairs(FindPigs()) do
            if candidate.Parent and IsReady(candidate) then
                local p=FindCarry(candidate)
                if p and p.Enabled then ready=ready+1 else waiting=waiting+1 end
            end
        end
        if ready>0 then SetStatus("Farm","Babi 100% sedang cooldown; scan ulang")
        elseif waiting>0 then SetStatus("Farm","Ada babi 100%; menunggu prompt Bawa")
        else SetStatus("Farm","Pakan "..amount.." | Scan babi 100%...") end
        return
    end
    local pigPart,carry=GetPart(pig),FindCarry(pig)
    if not pigPart or not carry or not carry.Enabled then
        RetryPigAt[pig]=os.clock()+PIG_RETRY_COOLDOWN
        SetStatus("Farm","Target belum siap; scan babi lain"); return
    end
    StartPig(pig,carry,pigPart)
end

