local function GetText(object)
    local ok,value = pcall(function()
        return object.Text
    end)

    return ok and typeof(value) == "string" and value or ""
end

local function IsVisible(object)
    if not object or not object:IsA("GuiObject") then
        return false
    end

    local current = object

    while current and current ~= PlayerGui do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end

        current = current.Parent
    end

    return true
end

local function FindButton(object)
    local current = object

    for _ = 1,10 do
        if not current then break end
        if current:IsA("GuiButton") then return current end
        current = current.Parent
    end

    return nil
end

local function FireButton(button)
    if not button or not button.Parent then
        return false
    end

    local fired = false

    pcall(function()
        if typeof(firesignal) == "function" then
            firesignal(button.Activated)
            fired = true
        end
    end)

    if not fired then
        pcall(function()
            button:Activate()
            fired = true
        end)
    end

    return fired
end

local function GetRakGui()
    return PlayerGui:FindFirstChild("RakGui")
end

local function GetRakMainFrame()
    local gui = GetRakGui()
    if not gui then return nil end

    if gui.Name == "MainFrame" then
        return gui
    end

    return gui:FindFirstChild("MainFrame",true)
end

local function RakTerbuka()
    local frame = GetRakMainFrame()

    return frame ~= nil
        and frame:IsA("GuiObject")
        and frame.Visible
end

local function FindRakController()
    if typeof(getgc) ~= "function" then
        return nil,nil
    end

    local ok,objects = pcall(function()
        return getgc(true)
    end)

    if not ok or type(objects) ~= "table" then
        return nil,nil
    end

    local gui = GetRakGui()
    local frame = GetRakMainFrame()

    for _,object in ipairs(objects) do
        if type(object) == "table" then
            local hasGui = false
            local openFunction = nil

            for key,value in pairs(object) do
                if gui and value == gui then
                    hasGui = true
                end

                if frame and value == frame then
                    hasGui = true
                end

                if key == "Open" and type(value) == "function" then
                    openFunction = value
                end
            end

            if hasGui and openFunction then
                return object,openFunction
            end
        end
    end

    return nil,nil
end

local function TryOpenController(controller,openFunction)
    if not openFunction then return false end

    pcall(function()
        openFunction()
    end)

    task.wait(0.2)

    if RakTerbuka() then
        return true
    end

    if controller then
        pcall(function()
            openFunction(controller)
        end)
    end

    task.wait(0.3)

    return RakTerbuka()
end

local function TryRakButtons(container)
    if not container then return false end

    local names = {
        rak = true,
        rakkios = true,
        rak_kios = true
    }

    for _,object in ipairs(container:GetDescendants()) do
        if object:IsA("GuiButton") then
            local name = string.lower(object.Name)

            if names[name] and IsVisible(object) then
                FireButton(object)
                task.wait(0.35)

                if RakTerbuka() then
                    return true
                end
            end
        end
    end

    return false
end

local function OpenRak()
    if RakTerbuka() then
        return true
    end

    SetStatus("Restock","Mencari cara membuka Rak Kios")

    local controller,openFunction = FindRakController()

    if controller and openFunction then
        if TryOpenController(controller,openFunction) then
            SetStatus("Restock","Rak berhasil dibuka")
            return true
        end
    end

    local gui = GetRakGui()

    if gui and TryRakButtons(gui) then
        SetStatus("Restock","Rak berhasil dibuka")
        return true
    end

    if TryRakButtons(PlayerGui) then
        SetStatus("Restock","Rak berhasil dibuka")
        return true
    end

    task.wait(0.25)

    controller,openFunction = FindRakController()

    if controller and openFunction then
        if TryOpenController(controller,openFunction) then
            SetStatus("Restock","Rak berhasil dibuka")
            return true
        end
    end

    return RakTerbuka()
end

local function FindIsi()
    local gui = GetRakGui()
    if not gui then return nil end

    for _,object in ipairs(gui:GetDescendants()) do
        if object:IsA("GuiButton") and IsVisible(object) then
            local name = string.lower(object.Name)

            if name == "isi" then
                return object
            end
        end
    end

    for _,object in ipairs(gui:GetDescendants()) do
        if object:IsA("GuiObject") and IsVisible(object) then
            local text = string.lower(GetText(object))

            if string.match(text,"^%s*isi%s*%+")
            or string.match(text,"^%s*isi%s*$") then
                local button = FindButton(object)

                if button and IsVisible(button) then
                    return button
                end
            end
        end
    end

    return nil
end

local function ProcessRak()
    if not F.Restock then return end

    if not RakTerbuka() then
        SetStatus("Restock","Membuka Rak Kios")

        local opened = OpenRak()

        if not opened then
            if not GetRakGui() then
                SetStatus("Restock","RakGui belum muncul; mencoba lagi")
            else
                SetStatus("Restock","Rak belum terbuka; mencoba lagi")
            end

            return
        end
    end

    if not RakTerbuka() then
        SetStatus("Restock","Menunggu Rak terbuka")
        return
    end

    local button = FindIsi()

    if not button then
        SetStatus("Restock","Rak terbuka, tombol Isi belum ditemukan")
        return
    end

    if FireButton(button) then
        SetStatus("Restock","Input tombol Isi dikirim")
    else
        SetStatus("Restock","Gagal mengaktifkan tombol Isi")
    end

    task.wait(0.8)
end

task.spawn(function()
    while ScreenGui.Parent do
        if F.Restock then
            local ok,err = pcall(ProcessRak)

            if not ok then
                SetStatus("Restock","Error: "..tostring(err))
            end

            task.wait(0.8)
        else
            task.wait(0.25)
        end
    end
end)

