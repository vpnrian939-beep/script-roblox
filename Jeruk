local harvestCooldown = {}

local function remoteHarvest(object,boxNumber)
    local remote = getPanenRemote()

    if not remote then
        SetStatus("Jeruk","Remote Panen tidak ditemukan!")
        return false
    end

    if not object or not object.Parent then
        SetStatus("Jeruk","Tanaman Box "..boxNumber.." hilang!")
        return false
    end

    if object:GetAttribute("Harvested") then
        SetStatus("Jeruk","Box "..boxNumber.." sudah dipanen!")
        return true
    end

    if not object:GetAttribute("Ready") then
        SetStatus("Jeruk","Box "..boxNumber.." belum siap!")
        return false
    end

    for attempt = 1,3 do
        if not running then return false end

        if not object.Parent then
            return false
        end

        if object:GetAttribute("Harvested") then
            SetStatus("Jeruk","Box "..boxNumber.." berhasil dipanen!")
            return true
        end

        if not object:GetAttribute("Ready") then
            SetStatus("Jeruk","Tanaman tidak lagi siap!")
            return false
        end

        local now = os.clock()
        local nextAllowed = harvestCooldown[object] or 0

        if now < nextAllowed then
            task.wait(nextAllowed-now)
        end

        if not running then return false end

        if object.Parent
            and object:GetAttribute("Ready")
            and not object:GetAttribute("Harvested") then

            harvestCooldown[object] = os.clock()+0.5

            remote:FireServer(object)

            SetStatus("Jeruk","Remote Panen Box "..
                boxNumber.." ("..attempt.."/3)")
        end

        task.wait(0.55)
    end

    if object.Parent and object:GetAttribute("Harvested") then
        SetStatus("Jeruk","Box "..boxNumber.." berhasil dipanen!")
        return true
    end

    SetStatus("Jeruk","Permintaan panen Box "..boxNumber.." terkirim")

    return true
end

--==================================================
-- SIKLUS UTAMA AUTO JERUK
--==================================================

local function runCycle()

    -- PERIKSA 12 BOX
    local plots = {}

    for i = 1,12 do
        local lahan = getLahan(i)

        if not lahan then
            SetStatus("Jeruk","LahanBox "..i.." tidak ditemukan!")
            return false
        end

        local position = getPosition(lahan)
        local plantPosition = getPlantPosition(lahan)

        if not position or not plantPosition then
            SetStatus("Jeruk","Posisi Box "..i.." tidak ditemukan!")
            return false
        end

        plots[i] = {
            object = lahan,
            position = position,
            plantPosition = plantPosition,
            index = i
        }
    end

    --==================================================
    -- TANAM 12 BOX
    --==================================================

    SetStatus("Jeruk","Mencari bibit jeruk...")

    local seed = findTool("BibitJeruk")
    local tanamRemote = getTanamRemote()

    if not seed or not tanamRemote then
        SetStatus("Jeruk","Bibit atau Remote Tanam tidak ditemukan!")
        return false
    end

    if not equip(seed) then return false end

    for i = 1,12 do
        if not running then return false end

        local crop = plots[i]

        SetStatus("Jeruk","Menanam Box "..i.." / 12")

        if not moveTo(crop.position,i) then
            return false
        end

        tanamRemote:FireServer(crop.plantPosition)

        task.wait(2)
    end

    --==================================================
    -- SIRAM 12 BOX
    --==================================================

    SetStatus("Jeruk","Mencari penyiram...")

    local sprinkler = findTool("PenyiramTanaman")

    if not sprinkler then
        SetStatus("Jeruk","Penyiram tidak ditemukan!")
        return false
    end

    if not equip(sprinkler) then return false end

    for i = 1,12 do
        if not running then
            sprinkler:Deactivate()
            return false
        end

        local crop = plots[i]

        SetStatus("Jeruk","Menyiram Box "..i.." / 12")

        if not moveTo(crop.position,i) then
            sprinkler:Deactivate()
            return false
        end

        sprinkler:Activate()
        task.wait(4)
        sprinkler:Deactivate()

        task.wait(2)
    end

    --==================================================
    -- TUNGGU 130 DETIK
    --==================================================

    for remaining = 130,1,-1 do
        if not running then return false end

        SetStatus("Jeruk","Menunggu jeruk: "..remaining.." detik")
        task.wait(1)
    end

    --==================================================
    -- KOSONGKAN TANGAN
    --==================================================

    local humanoid = getHumanoid()

    if humanoid then
        humanoid:UnequipTools()
    end

    task.wait(1)

    --==================================================
    -- CARI 12 TANAMAN UNTUK PANEN
    --==================================================

    SetStatus("Jeruk","Mencari tanaman di Plot...")

    local usedBases = {}
    local harvestTargets = {}

    for i = 1,12 do
        if not running then return false end

        local crop = plots[i]

        local target = getHarvestBase(
            crop.position,
            usedBases
        )

        if not target then
            SetStatus("Jeruk","Tanaman Box "..i.." tidak ditemukan!")
            return false
        end

        harvestTargets[i] = target
    end

    --==================================================
    -- PANEN 12 BOX MENGGUNAKAN REMOTE
    --==================================================

    for i = 1,12 do
        if not running then return false end

        local target = harvestTargets[i]

        if not target or not target.Parent then
            SetStatus("Jeruk","Target Box "..i.." hilang!")
            return false
        end

        SetStatus("Jeruk","Menuju Box "..i.." untuk panen")

        if not moveToHarvest(target.Position,i) then
            return false
        end

        SetStatus("Jeruk","Panen Box "..i.." / 12")

        if not remoteHarvest(target,i) then
            SetStatus("Jeruk","Panen Box "..i.." gagal!")
            return false
        end

        task.wait(1)
    end

    return true
end

--==================================================
-- LOOP AUTO JERUK
--==================================================

local function StartJeruk()
    if busy then return end

    running = true
    busy = true

    task.spawn(function()
        while running and ScreenGui.Parent do
            local success,result = pcall(runCycle)

            if not success then
                SetStatus("Jeruk","Error: "..tostring(result))
                running = false
                break
            end

            if result == false then
                running = false
                break
            end

            SetStatus("Jeruk","12 Box selesai! Mengulang...")
            task.wait(2)
        end

        busy = false

        if ScreenGui.Parent then
            F.Jeruk = false
            UpdateToggle("Jeruk")

            if not running then
                SetStatus("Jeruk","Mati")
            end
        end
    end)
end

