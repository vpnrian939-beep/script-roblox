local function getPlotFolder()
    return workspace:FindFirstChild("Plot")
end

local function getHarvestBase(boxPosition,usedBases)
    local plot = getPlotFolder()

    if not plot then
        SetStatus("Jeruk","Workspace.Plot tidak ditemukan!")
        return nil
    end

    local nearest = nil
    local nearestDistance = math.huge

    for _,object in ipairs(plot:GetDescendants()) do
        if object:IsA("BasePart")
            and object:GetAttribute("PlantKey")
            and object:GetAttribute("OwnerId") == Player.UserId
            and not usedBases[object] then

            local offset = object.Position-boxPosition
            local distance = Vector2.new(offset.X,offset.Z).Magnitude

            if distance < nearestDistance then
                nearestDistance = distance
                nearest = object
            end
        end
    end

    if nearest and nearestDistance <= 18 then
        usedBases[nearest] = true
        return nearest
    end

    return nil
end

