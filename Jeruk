local function findTool(keyword)
    local function search(container)
        if not container then return nil end

        for _,tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:gsub("%s+",""):lower()

                if name:find(
                    keyword:gsub("%s+",""):lower(),
                    1,
                    true
                ) then
                    return tool
                end
            end
        end
    end

    return search(Player.Backpack)
        or search(Player.Character)
end

local function getHumanoid()
    local character = Player.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function equip(tool)
    local humanoid = getHumanoid()
    if not humanoid or not tool then return false end

    humanoid:EquipTool(tool)
    task.wait(0.7)

    return running and tool.Parent == Player.Character
end

