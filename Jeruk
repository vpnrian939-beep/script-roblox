local function getLahan(i)
    return workspace:FindFirstChild("LahanBox"..i,true)
end

local function getPosition(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object.Position
    elseif object:IsA("Model") then
        return object:GetPivot().Position
    end

    return nil
end

local function getPlantPosition(object)
    if object:IsA("BasePart") then
        return object.Position + Vector3.new(0,object.Size.Y/2,0)

    elseif object:IsA("Model") then
        local cf,size = object:GetBoundingBox()
        return cf.Position + Vector3.new(0,size.Y/2,0)
    end
end

--==================================================
-- GERAK TANAM DAN SIRAM
--==================================================

local function moveTo(position,boxNumber)
    local humanoid = getHumanoid()
    local character = Player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        SetStatus("Jeruk","Karakter tidak ditemukan!")
        return false
    end

    for attempt = 1,3 do
        if not running then return false end

        humanoid:MoveTo(position)

        local start = os.clock()

        while running and os.clock()-start < 12 do
            character = Player.Character
            root = character and character:FindFirstChild("HumanoidRootPart")

            if not root then return false end

            if (root.Position-position).Magnitude <= 9 then
                return true
            end

            task.wait(0.15)
        end

        SetStatus("Jeruk","Menuju Box "..boxNumber..
            " ("..attempt.."/3)")

        task.wait(0.5)
    end

    SetStatus("Jeruk","Gagal mencapai Box "..boxNumber.."!")
    return false
end

--==================================================
-- GERAK KHUSUS PANEN
--==================================================

local function moveToHarvest(position,boxNumber)
    for attempt = 1,5 do
        if not running then return false end

        local character = Player.Character
        local humanoid = getHumanoid()
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root then
            SetStatus("Jeruk","Karakter tidak ditemukan!")
            return false
        end

        humanoid:MoveTo(position)

        local start = os.clock()
        local arrivedAt = nil

        while running and os.clock()-start < 12 do
            character = Player.Character
            root = character and character:FindFirstChild("HumanoidRootPart")

            if not root then return false end

            local offset = root.Position-position
            local distance = Vector2.new(offset.X,offset.Z).Magnitude

            if distance <= 5 then
                if not arrivedAt then
                    arrivedAt = os.clock()
                    SetStatus("Jeruk","Tiba di Box "..boxNumber..
                        " - Diam 1 detik...")
                end

                if os.clock()-arrivedAt >= 1 then
                    return true
                end
            else
                arrivedAt = nil
            end

            task.wait(0.1)
        end

        SetStatus("Jeruk","Mendekati Box "..boxNumber..
            " ("..attempt.."/5)")
    end

    SetStatus("Jeruk","Gagal mendekati Box "..boxNumber.."!")
    return false
end

