local function StartOrange()
    if busy then return end

    busy=true
    running=true

    task.spawn(function()
        while running and alive and ScreenGui.Parent do
            local ok,result=pcall(RunOrangeCycle)

            if not running or not alive then
                break
            end

            if not ok then
                SetStatus("Jeruk","Terjadi error - mencoba ulang, tetap ON")
                task.wait(4)
            elseif result==false then
                SetStatus("Jeruk","Siklus gagal - mencoba ulang, tetap ON")
                task.wait(4)
            else
                SetStatus("Jeruk","12 Box selesai! Mengulang...")
                task.wait(2)
            end
        end

        busy=false

        if not alive then return end

        if not running then
            F.Jeruk=false
            UpdateToggle("Jeruk")
            SetStatus("Jeruk","OFF oleh pengguna")
        end
    end)
end

