--========================================================

local function GetLahan(i)
    return workspace:FindFirstChild("LahanBox"..i,true)
end

local function GetPosition(object)
    if object:IsA("BasePart") then
        return object.Position
    elseif object:IsA("Model") then
        return object:GetPivot().Position
    end
end

local function GetPlantPosition(object)
    if object:IsA("BasePart") then
        return object.Position+Vector3.new(0,object.Size.Y/2,0)
    elseif object:IsA("Model") then
        local cf,size=object:GetBoundingBox()
        return cf.Position+Vector3.new(0,size.Y/2,0)
    end
end

local function MoveTo(position,box)
    for attempt=1,3 do
        if not running or not alive then return false end
        if not WaitForCowTeleport() then return false end

        local humanoid=GetHumanoid()
        local character=Player.Character
        local root=character and character:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root then
            task.wait(1)
        else
            humanoid:MoveTo(position)
            local start=os.clock()

            while running and alive and os.clock()-start<12 do
                if not WaitForCowTeleport() then break end

                character=Player.Character
                root=character and character:FindFirstChild("HumanoidRootPart")

                if not root then break end

                if (root.Position-position).Magnitude<=9 then
                    return true
                end

                task.wait(0.15)
            end
        end

        SetStatus("Jeruk","Menuju Box "..box.." ("..attempt.."/3)")
    end

    return false
end

local function MoveToHarvest(position,box)
    for attempt=1,5 do
        if not running or not alive then return false end
        if not WaitForCowTeleport() then return false end

        local humanoid=GetHumanoid()
        local character=Player.Character
        local root=character and character:FindFirstChild("HumanoidRootPart")

        if humanoid and root then
            humanoid:MoveTo(position)

            local start=os.clock()
            local arrived

            while running and alive and os.clock()-start<12 do
                if not WaitForCowTeleport() then break end

                character=Player.Character
                root=character and character:FindFirstChild("HumanoidRootPart")

                if not root then break end

                local offset=root.Position-position
                local distance=Vector2.new(offset.X,offset.Z).Magnitude

                if distance<=5 then
                    if not arrived then arrived=os.clock() end
                    if os.clock()-arrived>=1 then return true end
                else
                    arrived=nil
                end

                task.wait(0.1)
            end
        end

        SetStatus("Jeruk","Mendekati Box "..box.." ("..attempt.."/5)")
    end

    return false
end

local function GetPlantBase(boxPosition,used)
    local plot=workspace:FindFirstChild("Plot")
    if not plot then return nil end

    local nearest
    local nearestDistance=math.huge

    for _,object in ipairs(plot:GetDescendants()) do
        if object:IsA("BasePart")
        and object:GetAttribute("PlantKey")
        and object:GetAttribute("OwnerId")==Player.UserId
        and not used[object] then

            local offset=object.Position-boxPosition
            local distance=Vector2.new(offset.X,offset.Z).Magnitude

            if distance<nearestDistance then
                nearestDistance=distance
                nearest=object
            end
        end
    end

    if nearest and nearestDistance<=18 then
        used[nearest]=true
        return nearest
    end

    return nil
end

local function Harvest(object,box)
    local remote=GetRemote("Panen",15)

    if not remote or not object or not object.Parent then
        return false
    end

    for attempt=1,3 do
        if not running or not alive then return false end
        if not WaitForCowTeleport() then return false end
        if not object.Parent then return false end

        if object:GetAttribute("Harvested") then
            return true
        end

        if not object:GetAttribute("Ready") then
            SetStatus("Jeruk","Tanaman Box "..box.." belum siap")
            return false
        end

        local nextAllowed=harvestCooldown[object] or 0

        if os.clock()<nextAllowed then
            task.wait(nextAllowed-os.clock())
        end

        if not running or not alive then return false end
        if not WaitForCowTeleport() then return false end

        harvestCooldown[object]=os.clock()+0.5
        remote:FireServer(object)

        SetStatus("Jeruk","Panen Box "..box.." ("..attempt.."/3)")
        task.wait(0.55)
    end

    return true
end

local function RunOrangeCycle()
    local plots={}

    for i=1,12 do
        if not running or not alive then return false end

        local lahan=GetLahan(i)

        if not lahan then
            SetStatus("Jeruk","LahanBox "..i.." belum ditemukan - mencoba ulang")
            return false
        end

        plots[i]={
            object=lahan,
            position=GetPosition(lahan),
            plantPosition=GetPlantPosition(lahan)
        }

        if not plots[i].position or not plots[i].plantPosition then
            SetStatus("Jeruk","Posisi Box "..i.." belum terbaca")
            return false
        end
    end

    local seed=FindTool("BibitJeruk")
    local tanam=GetRemote("Tanam",15)

    if not seed or not tanam then
        SetStatus("Jeruk","Menunggu bibit atau Remote Tanam...")
        return false
    end

    if not Equip(seed) then
        SetStatus("Jeruk","Gagal equip bibit - mencoba ulang")
        return false
    end

    for i=1,12 do
        if not running or not alive then return false end
        if not WaitForCowTeleport() then return false end

        SetStatus("Jeruk","Menanam Box "..i.."/12")

        if not MoveTo(plots[i].position,i) then
            return false
        end

        tanam:FireServer(plots[i].plantPosition)
        task.wait(2)
    end

    local sprinkler=FindTool("PenyiramTanaman")

    if not sprinkler then
        SetStatus("Jeruk","Penyiram belum ditemukan - mencoba ulang")
        return false
    end

    if not Equip(sprinkler) then
        SetStatus("Jeruk","Gagal equip penyiram - mencoba ulang")
        return false
    end

    for i=1,12 do
        if not running or not alive then
            pcall(function() sprinkler:Deactivate() end)
            return false
        end

        if not WaitForCowTeleport() then
            pcall(function() sprinkler:Deactivate() end)
            return false
        end

        SetStatus("Jeruk","Menyiram Box "..i.."/12")

        if not MoveTo(plots[i].position,i) then
            pcall(function() sprinkler:Deactivate() end)
            return false
        end

        sprinkler:Activate()
        task.wait(4)
        sprinkler:Deactivate()
        task.wait(2)
    end

    for remaining=130,1,-1 do
        if not running or not alive then return false end
        if not WaitForCowTeleport() then return false end

        SetStatus("Jeruk","Menunggu jeruk "..remaining.." detik")
        task.wait(1)
    end

    local humanoid=GetHumanoid()
    if humanoid then humanoid:UnequipTools() end
    task.wait(1)

    local used={}
    local targets={}

    for i=1,12 do
        if not running or not alive then return false end
        if not WaitForCowTeleport() then return false end

        targets[i]=GetPlantBase(plots[i].position,used)

        if not targets[i] then
            SetStatus("Jeruk","Tanaman Box "..i.." belum ditemukan")
            return false
        end
    end

    for i=1,12 do
        if not running or not alive then return false end
        if not WaitForCowTeleport() then return false end

        local target=targets[i]

        if not target or not target.Parent then
            SetStatus("Jeruk","Target Box "..i.." hilang")
            return false
        end

        SetStatus("Jeruk","Menuju Box "..i.." untuk panen")

        if not MoveToHarvest(target.Position,i) then
            return false
        end

        if not Harvest(target,i) then
            return false
        end

        task.wait(1)
    end

    return true
end

