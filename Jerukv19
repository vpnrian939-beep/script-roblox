local function GetCowPen()
    local exact=workspace:FindFirstChild("KandangSapi_2919114494",true)
    if exact then return exact end

    for _,object in ipairs(workspace:GetDescendants()) do
        if object.Name:match("^KandangSapi_") then
            return object
        end
    end

    return nil
end

local function GetCowPrompt(promptName)
    local pen=GetCowPen()
    if not pen then return nil end

    local prompt=pen:FindFirstChild(promptName,true)

    if prompt and prompt:IsA("ProximityPrompt") then
        return prompt
    end

    return nil
end

local function TriggerPrompt(prompt)
    if not prompt or not prompt.Parent then
        return false,"Prompt tidak ditemukan"
    end

    if not prompt.Enabled then
        return false,"Prompt belum aktif"
    end

    if typeof(fireproximityprompt)=="function" then
        local ok=pcall(function()
            fireproximityprompt(prompt,prompt.HoldDuration)
        end)
        if ok then return true end
    end

    local ok,err=pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(prompt.HoldDuration,0)+0.1)
        prompt:InputHoldEnd()
    end)

    if ok then return true end
    return false,tostring(err)
end

local function GetPromptPosition(prompt)
    if not prompt or not prompt.Parent then return nil end

    local parent=prompt.Parent

    if parent:IsA("Attachment") then
        return parent.WorldPosition
    elseif parent:IsA("BasePart") then
        return parent.Position
    elseif parent:IsA("Model") then
        return parent:GetPivot().Position
    end

    local part=parent:FindFirstAncestorWhichIsA("BasePart")
    if part then return part.Position end

    return nil
end

local function WaitForCowTeleport()
    while cowTeleporting and alive do
        task.wait(0.1)
    end
    return alive
end

local function TeleportToPrompt(prompt)
    local character=Player.Character
    local root=character and character:FindFirstChild("HumanoidRootPart")

    if not character or not root then
        return nil,nil,"Karakter tidak ditemukan"
    end

    local position=GetPromptPosition(prompt)
    if not position then
        return nil,nil,"Posisi prompt tidak terbaca"
    end

    local savedCFrame=root.CFrame
    character:PivotTo(CFrame.new(position+Vector3.new(0,3,0)))
    task.wait(1)

    return savedCFrame,character,nil
end

local function ReturnToSavedPosition(savedCFrame)
    if not savedCFrame then return end

    local character=Player.Character
    if character then
        pcall(function()
            character:PivotTo(savedCFrame)
        end)
    end

    task.wait(1)
end

--========================================================
-- PEMBACA PAKAN
-- PRIORITAS: TEKS PAKAN + ANGKA
-- CADANGAN: POLA LAMA V17
--========================================================

local function GetFeedAmount()
    local pen=GetCowPen()
    if not pen then return nil end

    local fallback=nil

    for _,obj in ipairs(pen:GetDescendants()) do
        if obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox") then

            local text=tostring(obj.Text or "")
            local upper=text:upper()
            local current,total=text:match("(%d+)%s*/%s*(%d+)")

            if current and tonumber(total)==MAX_PAKAN then
                current=tonumber(current)

                if upper:find("PAKAN",1,true)
                or upper:find("FEED",1,true) then
                    return current
                end

                -- Pola pembacaan V17, tetapi jangan mengambil
                -- angka yang berasal dari label SUSU.
                if not upper:find("SUSU",1,true)
                and not upper:find("MILK",1,true)
                and fallback==nil then
                    fallback=current
                end
            end
        end
    end

    return fallback
end

--========================================================
-- PEMBACA SUSU
--========================================================

local function GetMilkAmount()
    local pen=GetCowPen()
    if not pen then return nil end

    for _,obj in ipairs(pen:GetDescendants()) do
        if obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox") then

            local text=tostring(obj.Text or "")
            local upper=text:upper()

            if upper:find("SUSU",1,true)
            or upper:find("MILK",1,true) then

                local current,total=text:match("(%d+)%s*/%s*(%d+)")

                if current and tonumber(total)==MAX_SUSU then
                    return tonumber(current)
                end

                -- Jika angka berada di objek anak atau saudara,
                -- periksa teks dalam container terdekat.
                local parent=obj.Parent
                if parent then
                    for _,child in ipairs(parent:GetDescendants()) do
                        if child:IsA("TextLabel")
                        or child:IsA("TextButton")
                        or child:IsA("TextBox") then

                            local n,t=tostring(child.Text or ""):match("(%d+)%s*/%s*(%d+)")
                            if n and tonumber(t)==MAX_SUSU then
                                return tonumber(n)
                            end
                        end
                    end
                end
            end
        end
    end

    return nil
end

