local function MilkAtCow()
    if susuBusy or pakanBusy or cowTeleporting then return end

    susuBusy=true
    cowTeleporting=true

    local savedCFrame
    local teleported=false
    local collected=false
    local failureReason

    local ok,err=pcall(function()
        local prompt=GetCowPrompt("AmbilPrompt")

        if not prompt then
            failureReason="AmbilPrompt tidak ditemukan"
            return
        end

        SetStatus("Susu","Menyimpan posisi...")
        local saved,character,reason=TeleportToPrompt(prompt)

        if not saved then
            failureReason=reason
            return
        end

        savedCFrame=saved
        teleported=true

        local startAmount=GetMilkAmount()

        if startAmount==nil then
            failureReason="Angka susu tidak terbaca"
            return
        end

        local startTime=os.clock()

        while alive and F.Susu and os.clock()-startTime<30 do
            local amount=GetMilkAmount()

            if amount==nil then
                failureReason="Angka susu tidak terbaca"
                break
            end

            if amount<MIN_SUSU or amount<startAmount then
                collected=true
                break
            end

            prompt=GetCowPrompt("AmbilPrompt")

            if not prompt then
                failureReason="AmbilPrompt hilang"
                break
            end

            if prompt.Enabled then
                TriggerPrompt(prompt)
                SetStatus("Susu","Mengambil susu: "..amount.."/60")
            else
                SetStatus("Susu","Menunggu AmbilPrompt...")
            end

            task.wait(1.5)
        end

        if not collected and not failureReason then
            failureReason="Susu belum berubah"
        end
    end)

    if not ok then
        failureReason="Error: "..tostring(err)
    end

    if teleported then
        SetStatus("Susu","Kembali ke posisi awal...")
        ReturnToSavedPosition(savedCFrame)
    end

    cowTeleporting=false
    susuBusy=false

    if collected then
        SetStatus("Susu","Susu diambil - kembali ke posisi awal")
    elseif failureReason then
        SetStatus("Susu",failureReason.." - posisi dikembalikan")
    else
        SetStatus("Susu","Selesai")
    end
end

