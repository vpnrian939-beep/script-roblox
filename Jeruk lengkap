local function GetLahan(i)
    return workspace:FindFirstChild("LahanBox"..i,true)
end

local function GetPosition(object)
    if object:IsA("BasePart") then
        return object.Position
    elseif object:IsA("Model") then
        return object:GetPivot().Position
    end
end

local function GetPlantPosition(object)
    if object:IsA("BasePart") then
        return object.Position + Vector3.new(0,object.Size.Y/2,0)
    elseif object:IsA("Model") then
        local cf,size = object:GetBoundingBox()
        return cf.Position + Vector3.new(0,size.Y/2,0)
    end
end

local function MoveTo(position,box)
    local humanoid = GetHumanoid()
    local character = Player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then return false end

    for attempt = 1,3 do
        if not running then return false end

        humanoid:MoveTo(position)

        local start = os.clock()

        while running and os.clock()-start < 12 do
            character = Player.Character
            root = character and character:FindFirstChild("HumanoidRootPart")

            if not root then return false end

            if (root.Position-position).Magnitude <= 9 then
                return true
            end

            task.wait(0.15)
        end

        SetStatus("Jeruk","Menuju Box "..box.." ("..attempt.."/3)")
    end

    return false
end

local function MoveToHarvest(position,box)
    local humanoid = GetHumanoid()

    if not humanoid then return false end

    for attempt = 1,5 do
        if not running then return false end

        local character = Player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not root then return false end

        humanoid:MoveTo(position)

        local start = os.clock()
        local arrived = nil

        while running and os.clock()-start < 12 do
            character = Player.Character
            root = character and character:FindFirstChild("HumanoidRootPart")

            if not root then return false end

            local offset = root.Position-position
            local distance = Vector2.new(offset.X,offset.Z).Magnitude

            if distance <= 5 then
                if not arrived then
                    arrived = os.clock()
                end

                if os.clock()-arrived >= 1 then
                    return true
                end
            else
                arrived = nil
            end

            task.wait(0.1)
        end

        SetStatus("Jeruk","Mendekati Box "..box.." ("..attempt.."/5)")
    end

    return false
end

local function GetPlantBase(boxPosition,used)
    local plot = workspace:FindFirstChild("Plot")
    if not plot then return nil end

    local nearest
    local nearestDistance = math.huge

    for _,object in ipairs(plot:GetDescendants()) do
        if object:IsA("BasePart")
        and object:GetAttribute("PlantKey")
        and object:GetAttribute("OwnerId") == Player.UserId
        and not used[object] then

            local offset = object.Position-boxPosition
            local distance = Vector2.new(offset.X,offset.Z).Magnitude

            if distance < nearestDistance then
                nearestDistance = distance
                nearest = object
            end
        end
    end

    if nearest and nearestDistance <= 18 then
        used[nearest] = true
        return nearest
    end

    return nil
end

local function Harvest(object,box)
    local remote = GetRemote("Panen",15)
    if not remote then return false end

    if not object or not object.Parent then return false end

    for attempt = 1,3 do
        if not running then return false end
        if not object.Parent then return false end

        if object:GetAttribute("Harvested") then
            return true
        end

        if not object:GetAttribute("Ready") then
            SetStatus("Jeruk","Tanaman Box "..box.." belum siap")
            return false
        end

        local nextAllowed = harvestCooldown[object] or 0

        if os.clock() < nextAllowed then
            task.wait(nextAllowed-os.clock())
        end

        if not running then return false end

        harvestCooldown[object] = os.clock()+0.5

        remote:FireServer(object)

        SetStatus("Jeruk","Panen Box "..box.." ("..attempt.."/3)")
        task.wait(0.55)
    end

    return true
end

local function RunOrangeCycle()
    local plots = {}

    -- CEK 12 LAHAN

    for i = 1,12 do
        local lahan = GetLahan(i)

        if not lahan then
            SetStatus("Jeruk","LahanBox "..i.." tidak ditemukan")
            return false
        end

        plots[i] = {
            object = lahan,
            position = GetPosition(lahan),
            plantPosition = GetPlantPosition(lahan)
        }
    end

    -- TANAM JERUK

    local seed = FindTool("BibitJeruk")
    local tanam = GetRemote("Tanam",15)

    if not seed or not tanam then
        SetStatus("Jeruk","Bibit atau Remote Tanam tidak ditemukan")
        return false
    end

    if not Equip(seed) then return false end

    for i = 1,12 do
        if not running then return false end

        SetStatus("Jeruk","Menanam Box "..i.."/12")

        if not MoveTo(plots[i].position,i) then
            return false
        end

        tanam:FireServer(plots[i].plantPosition)
        task.wait(2)
    end

    -- SIRAM JERUK

    local sprinkler = FindTool("PenyiramTanaman")

    if not sprinkler then
        SetStatus("Jeruk","Penyiram tidak ditemukan")
        return false
    end

    if not Equip(sprinkler) then return false end

    for i = 1,12 do
        if not running then
            sprinkler:Deactivate()
            return false
        end

        SetStatus("Jeruk","Menyiram Box "..i.."/12")

        if not MoveTo(plots[i].position,i) then
            sprinkler:Deactivate()
            return false
        end

        sprinkler:Activate()
        task.wait(4)
        sprinkler:Deactivate()
        task.wait(2)
    end

    -- TUNGGU 130 DETIK

    for remaining = 130,1,-1 do
        if not running then return false end

        SetStatus("Jeruk","Menunggu jeruk "..remaining.." detik")
        task.wait(1)
    end

    local humanoid = GetHumanoid()

    if humanoid then
        humanoid:UnequipTools()
    end

    task.wait(1)

    -- CARI TANAMAN

    local used = {}
    local targets = {}

    for i = 1,12 do
        if not running then return false end

        targets[i] = GetPlantBase(plots[i].position,used)

        if not targets[i] then
            SetStatus("Jeruk","Tanaman Box "..i.." tidak ditemukan")
            return false
        end
    end

    -- PANEN JERUK

    for i = 1,12 do
        if not running then return false end

        local target = targets[i]

        if not target or not target.Parent then
            return false
        end

        SetStatus("Jeruk","Menuju Box "..i.." untuk panen")

        if not MoveToHarvest(target.Position,i) then
            return false
        end

        if not Harvest(target,i) then
            return false
        end

        task.wait(1)
    end

    return true
end

local function StartOrange()
    if busy then return end

    busy = true
    running = true

    task.spawn(function()
        while running and ScreenGui.Parent do
            local ok,result = pcall(RunOrangeCycle)

            if not ok then
                SetStatus("Jeruk","Error: "..tostring(result))
                running = false
                break
            end

            if result == false then
                running = false
                break
            end

            SetStatus("Jeruk","12 Box selesai! Mengulang...")
            task.wait(2)
        end

        busy = false
        F.Jeruk = false
        UpdateToggle("Jeruk")
        SetStatus("Jeruk","Mati")
    end)
end

