local function RakGui()
    return Player:WaitForChild("PlayerGui"):FindFirstChild("RakGui")
end

local function RakMain()
    local gui = RakGui()
    if not gui then return nil end
    return gui:FindFirstChild("MainFrame",true)
end

local function RakTerbuka()
    local frame = RakMain()
    return frame ~= nil and frame.Visible
end

local function FindIsi()
    local gui = RakGui()
    if not gui then return nil end

    for _,object in ipairs(gui:GetDescendants()) do
        if object:IsA("GuiButton") then
            if object.Visible and object.Name:lower() == "isi" then
                return object
            end
        end
    end

    for _,object in ipairs(gui:GetDescendants()) do
        if object:IsA("TextButton") and object.Visible then
            if object.Text:lower():find("isi",1,true) then
                return object
            end
        end
    end

    return nil
end

local function FireButton(button)
    if not button then return false end

    local success = false

    pcall(function()
        if typeof(firesignal) == "function" then
            firesignal(button.Activated)
            success = true
        end
    end)

    if not success then
        pcall(function()
            button:Activate()
            success = true
        end)
    end

    return success
end

local function OpenRak()
    if RakTerbuka() then return true end

    local gui = RakGui()

    if gui then
        for _,object in ipairs(gui:GetDescendants()) do
            if object:IsA("GuiButton") and object.Visible then
                local name = object.Name:lower()

                if name:find("rak",1,true) then
                    FireButton(object)
                    task.wait(0.5)

                    if RakTerbuka() then return true end
                end
            end
        end
    end

    for _,object in ipairs(Player.PlayerGui:GetDescendants()) do
        if object:IsA("GuiButton") and object.Visible then
            local name = object.Name:lower()

            if name:find("rak",1,true) then
                FireButton(object)
                task.wait(0.5)

                if RakTerbuka() then return true end
            end
        end
    end

    return RakTerbuka()
end

local function ProcessRestock()
    if not RakTerbuka() then
        SetStatus("Restock","Membuka Rak Kios...")

        if not OpenRak() then
            SetStatus("Restock","Rak belum terbuka")
            return
        end
    end

    local button = FindIsi()

    if not button then
        SetStatus("Restock","Tombol Isi tidak ditemukan")
        return
    end

    if FireButton(button) then
        SetStatus("Restock","Tombol Isi dikirim")
    else
        SetStatus("Restock","Gagal menekan Isi")
    end
end

task.spawn(function()
    while ScreenGui.Parent do
        if F.Restock then
            local ok,err = pcall(ProcessRestock)

            if not ok then
                SetStatus("Restock","Error: "..tostring(err))
            end

            task.wait(1)
        else
            task.wait(0.5)
        end
    end
end)

