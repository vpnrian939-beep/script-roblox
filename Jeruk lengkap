local function GetRemoteFolder()
    local module = ReplicatedStorage:FindFirstChild("RemoteRegistry")
    if not module then return nil end

    local ok,registry = pcall(require,module)
    if not ok then return nil end

    local success,folder = pcall(function()
        return registry.folder("Remotes")
    end)

    if not success then return nil end
    return folder
end

local function GetRemote(name,timeout)
    local folder = GetRemoteFolder()
    if not folder then return nil end

    return folder:WaitForChild(name,timeout or 15)
end

--========================================================
-- TOOL HELPER
--========================================================

local function FindTool(keyword)
    local function Search(container)
        if not container then return nil end

        for _,tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:gsub("%s+",""):lower()
                local target = keyword:gsub("%s+",""):lower()

                if name:find(target,1,true) then
                    return tool
                end
            end
        end
    end

    return Search(Player.Backpack)
        or Search(Player.Character)
end

local function GetHumanoid()
    local character = Player.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function Equip(tool)
    local humanoid = GetHumanoid()
    if not humanoid or not tool then return false end

    humanoid:EquipTool(tool)
    task.wait(0.7)

    return tool.Parent == Player.Character
end

