local ShopBuyRemote
local OrangeSeedItem

local function LoadOrangeShop()
    local configModule = ReplicatedStorage:FindFirstChild("ShopConfig")

    if not configModule then
        SetStatus("Beli","ShopConfig tidak ditemukan!")
        return false
    end

    local ok,config = pcall(require,configModule)

    if not ok then
        SetStatus("Beli","Gagal membaca ShopConfig!")
        return false
    end

    OrangeSeedItem = config.Get("BibitJeruk")

    if not OrangeSeedItem then
        SetStatus("Beli","Data BibitJeruk tidak ditemukan!")
        return false
    end

    if OrangeSeedItem.ItemId ~= "BibitJeruk"
    or OrangeSeedItem.PlantKey ~= "Jeruk"
    or OrangeSeedItem.Category ~= "Bibit" then

        SetStatus("Beli","Data bibit jeruk tidak sesuai!")
        return false
    end

    local folder = GetRemoteFolder()

    if not folder then
        SetStatus("Beli","Folder Remotes tidak ditemukan!")
        return false
    end

    ShopBuyRemote = folder:FindFirstChild("ShopBuy")

    if not ShopBuyRemote then
        SetStatus("Beli","Remote ShopBuy tidak ditemukan!")
        return false
    end

    if not ShopBuyRemote:IsA("RemoteFunction") then
        SetStatus("Beli","ShopBuy bukan RemoteFunction!")
        return false
    end

    return true
end

local function GetSeedStock()
    local total = 0

    local function Scan(container)
        if not container then return end

        for _,tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:gsub("%s+",""):lower()

                if name:find("bibitjeruk",1,true) then
                    local amount =
                        tool:GetAttribute("Amount")
                        or tool:GetAttribute("Count")
                        or tool:GetAttribute("Quantity")
                        or tool:GetAttribute("Stack")

                    if typeof(amount) == "number" then
                        total = total + amount
                    else
                        local number = name:match("[xX](%d+)")
                        total = total + (tonumber(number) or 1)
                    end
                end
            end
        end
    end

    Scan(Player.Backpack)
    Scan(Player.Character)

    return total
end

local function BuyOrangeSeed()
    if buyBusy then return end
    buyBusy = true

    local success,err = pcall(function()
        local stock = GetSeedStock()

        SetStatus("Beli","Stok terbaca: "..stock)

        if stock >= MIN_SEED_STOCK then
            SetStatus("Beli","Stok masih cukup")
            return
        end

        if not LoadOrangeShop() then return end

        SetStatus("Beli","Membeli 120 bibit jeruk...")

        local result = ShopBuyRemote:InvokeServer(
            OrangeSeedItem.ItemId,
            BUY_AMOUNT
        )

        if type(result) == "table" then
            if result.ok == false then
                SetStatus("Beli","Pembelian ditolak server!")
                return
            end

            SetStatus("Beli","Permintaan pembelian berhasil dikirim!")
        else
            SetStatus("Beli","Permintaan pembelian dikirim!")
        end
    end)

    if not success then
        SetStatus("Beli","Error: "..tostring(err))
    end

    buyBusy = false
end

task.spawn(function()
    while ScreenGui.Parent do
        if F.Beli then
            BuyOrangeSeed()
            task.wait(15)
        else
            task.wait(2)
        end
    end
end)

