local function FeedAtCow()
    if pakanBusy or susuBusy or cowTeleporting then return end

    pakanBusy=true
    cowTeleporting=true

    local savedCFrame
    local teleported=false
    local finished=false
    local failureReason

    local ok,err=pcall(function()
        local prompt=GetCowPrompt("PakanPrompt")

        if not prompt then
            failureReason="PakanPrompt tidak ditemukan"
            return
        end

        SetStatus("Pakan","Menyimpan posisi...")

        local saved,character,reason=TeleportToPrompt(prompt)

        if not saved then
            failureReason=reason
            return
        end

        savedCFrame=saved
        teleported=true

        local startTime=os.clock()

        while alive and F.Pakan and os.clock()-startTime<75 do
            local amount=GetFeedAmount()

            if amount==nil then
                failureReason="Angka pakan tidak terbaca"
                break
            end

            if amount>=MAX_PAKAN then
                finished=true
                break
            end

            prompt=GetCowPrompt("PakanPrompt")

            if not prompt then
                failureReason="PakanPrompt hilang"
                break
            end

            if prompt.Enabled then
                TriggerPrompt(prompt)
                SetStatus("Pakan","Mengisi pakan: "..amount.."/60")
            else
                SetStatus("Pakan","Menunggu prompt: "..amount.."/60")
            end

            task.wait(1.5)
        end

        if not finished and not failureReason then
            failureReason="Waktu pengisian habis"
        end
    end)

    if not ok then
        failureReason="Error: "..tostring(err)
    end

    if teleported then
        SetStatus("Pakan","Kembali ke posisi awal...")
        ReturnToSavedPosition(savedCFrame)
    end

    cowTeleporting=false
    pakanBusy=false

    if finished then
        SetStatus("Pakan","Penuh 60/60 - kembali")
    elseif failureReason then
        SetStatus("Pakan",failureReason.." - posisi dikembalikan")
    else
        SetStatus("Pakan","Selesai")
    end
end

task.spawn(function()
    while alive and ScreenGui.Parent do
        if F.Pakan and not pakanBusy and not susuBusy then
            local amount=GetFeedAmount()

            if amount==nil then
                SetStatus("Pakan","Angka pakan belum terbaca")
            elseif amount<MIN_PAKAN then
                FeedAtCow()
            else
                SetStatus("Pakan","Pakan "..amount.."/60 - menunggu di bawah 20")
            end

            task.wait(2)
        else
            task.wait(0.5)
        end
    end
end)

