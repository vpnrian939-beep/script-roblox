--========================================================
-- AUTO JAGUNG 24 TANAMAN DI SATU TITIK
--========================================================

local function GetLahan()
    return workspace:FindFirstChild("Lahan1",true)
end

local function GetLahanBounds(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object.CFrame,object.Size
    elseif object:IsA("Model") then
        local cf,size=object:GetBoundingBox()
        return cf,size
    end

    return nil
end

local function GetCornPlantPoint(lahan)
    local cf,size=GetLahanBounds(lahan)
    if not cf or not size then return nil end

    return cf:PointToWorldSpace(Vector3.new(0,size.Y/2+0.5,0)),cf,size
end

local function IsInsideLahan(object,lahanCF,lahanSize)
    local localPosition=lahanCF:PointToObjectSpace(object.Position)

    return math.abs(localPosition.X)<=lahanSize.X/2+3
        and math.abs(localPosition.Z)<=lahanSize.Z/2+3
end

local function GetCornPlants(lahanCF,lahanSize)
    local plot=workspace:FindFirstChild("Plot")
    if not plot then return {} end

    local plants={}

    for _,object in ipairs(plot:GetDescendants()) do
        if object:IsA("BasePart")
        and object:GetAttribute("PlantKey")=="Jagung"
        and object:GetAttribute("OwnerId")==Player.UserId
        and IsInsideLahan(object,lahanCF,lahanSize) then

            table.insert(plants,object)
        end
    end

    return plants
end

local function GetRemoteSafe(name)
    local remote=GetRemote(name,15)

    if not remote or not remote:IsA("RemoteEvent") then
        return nil
    end

    return remote
end

--========================================================
-- TELEPORT LANGSUNG KE TITIK LAHAN1
--========================================================

local function TeleportToCornPoint(position)
    local character=Player.Character
    local root=character and character:FindFirstChild("HumanoidRootPart")

    if not character or not root then
        SetStatus("Jagung","Karakter tidak ditemukan")
        return false
    end

    local targetCFrame=CFrame.new(position+Vector3.new(0,3,0))

    local ok,err=pcall(function()
        character:PivotTo(targetCFrame)
    end)

    if not ok then
        SetStatus("Jagung","Teleport gagal: "..tostring(err))
        return false
    end

    task.wait(1)

    local newRoot=character:FindFirstChild("HumanoidRootPart")

    if not newRoot then
        SetStatus("Jagung","HumanoidRootPart hilang")
        return false
    end

    local distance=(newRoot.Position-targetCFrame.Position).Magnitude

    if distance>12 then
        SetStatus("Jagung","Teleport belum mencapai titik Lahan1")
        return false
    end

    SetStatus("Jagung","Berhasil teleport ke titik Lahan1")
    return true
end

--========================================================
-- TANAM 24X DI KOORDINAT YANG SAMA
--========================================================

local function PlantCornAtOnePoint(position)
    local seed=FindTool("BibitJagung")
    local tanam=GetRemoteSafe("Tanam")

    if not seed or not tanam then
        SetStatus("Jagung","Bibit atau Remote Tanam tidak ditemukan")
        return false
    end

    if not Equip(seed) then
        SetStatus("Jagung","Gagal equip bibit jagung")
        return false
    end

    for i=1,MAX_PLANTS do
        if not running or not alive then return false end
        if not WaitForCowTeleport() then return false end

        SetStatus("Jagung","Menanam satu titik "..i.."/24")

        local ok,err=pcall(function()
            tanam:FireServer(position)
        end)

        if not ok then
            SetStatus("Jagung","Tanam gagal: "..tostring(err))
            return false
        end

        task.wait(1)
    end

    return true
end

--========================================================
-- SIRAM SELAMA 3 DETIK
--========================================================

local function WaterCornOnce()
    local sprinkler=FindTool("PenyiramTanaman")

    if not sprinkler then
        SetStatus("Jagung","Penyiram tidak ditemukan")
        return false
    end

    if not Equip(sprinkler) then
        SetStatus("Jagung","Gagal equip penyiram")
        return false
    end

    if not running or not alive then return false end

    SetStatus("Jagung","Menyiram selama 3 detik...")

    local activated=false

    local ok,err=pcall(function()
        sprinkler:Activate()
        activated=true
        task.wait(WATER_DURATION)
        sprinkler:Deactivate()
    end)

    if not ok then
        if activated then
            pcall(function()
                sprinkler:Deactivate()
            end)
        end

        SetStatus("Jagung","Gagal menyiram: "..tostring(err))
        return false
    end

    SetStatus("Jagung","Siram selesai 3 detik")
    return true
end

--========================================================
-- HITUNG MUNDUR TEPAT 30 DETIK
--========================================================

local function WaitCorn30Seconds()
    local startTime=os.clock()

    while running and alive do
        if not WaitForCowTeleport() then return false end

        local elapsed=os.clock()-startTime
        local remaining=math.max(0,CORN_GROW_TIME-math.floor(elapsed))

        if elapsed>=CORN_GROW_TIME then
            SetStatus("Jagung","30 detik selesai - mulai panen")
            return true
        end

        SetStatus("Jagung","Menunggu panen: "..remaining.." detik")
        task.wait(0.2)
    end

    return false
end

--========================================================
-- PANEN 24X DARI SATU TITIK
--========================================================

local function HarvestAllAtOnePoint(lahanCF,lahanSize)
    local remote=GetRemoteSafe("Panen")

    if not remote then
        SetStatus("Jagung","Remote Panen tidak ditemukan")
        return false
    end

    local plants=GetCornPlants(lahanCF,lahanSize)

    if #plants<MAX_PLANTS then
        SetStatus("Jagung","Objek jagung ditemukan "..#plants.."/24")
        return false
    end

    local targets={}

    for _,plant in ipairs(plants) do
        if plant.Parent then
            table.insert(targets,plant)
        end

        if #targets>=MAX_PLANTS then
            break
        end
    end

    local sent=0

    for i=1,#targets do
        if not running or not alive then return false end
        if not WaitForCowTeleport() then return false end

        local target=targets[i]

        if target and target.Parent then
            local ok,err=pcall(function()
                remote:FireServer(target)
            end)

            if not ok then
                SetStatus("Jagung","Error panen: "..tostring(err))
                return false
            end

            sent=sent+1
            SetStatus("Jagung","Mengirim panen "..sent.."/24")

            task.wait(0.65)
        end
    end

    if sent<MAX_PLANTS then
        SetStatus("Jagung","Permintaan panen terkirim "..sent.."/24")
        return false
    end

    SetStatus("Jagung","24 permintaan panen terkirim")
    return true
end

--========================================================
-- SIKLUS JAGUNG V23
--========================================================

local function RunCornCycle()
    local lahan=GetLahan()

    if not lahan then
        SetStatus("Jagung","Lahan1 tidak ditemukan")
        return false
    end

    local position,lahanCF,lahanSize=GetCornPlantPoint(lahan)

    if not position then
        SetStatus("Jagung","Titik Lahan1 tidak terbaca")
        return false
    end

    -- TELEPORT LANGSUNG KE TITIK TANAM
    if not TeleportToCornPoint(position) then
        return false
    end

    -- TANAM 24X DI SATU TITIK
    if not PlantCornAtOnePoint(position) then
        return false
    end

    -- SIRAM SELAMA 3 DETIK
    if not WaterCornOnce() then
        return false
    end

    -- TUNGGU TEPAT 30 DETIK
    if not WaitCorn30Seconds() then
        return false
    end

    -- PANEN 24X DARI POSISI YANG SAMA
    if not HarvestAllAtOnePoint(lahanCF,lahanSize) then
        return false
    end

    SetStatus("Jagung","24 permintaan panen selesai!")
    return true
end

--========================================================
-- AUTO JAGUNG: TETAP ON SAAT ERROR
--========================================================

local function StartCorn()
    if busy then return end

    busy=true
    running=true

    task.spawn(function()
        while running and alive and ScreenGui.Parent do
            local ok,result=pcall(RunCornCycle)

            if not running or not alive then
                break
            end

            if not ok then
                SetStatus("Jagung","Error - mencoba ulang, tetap ON")
                task.wait(4)
            elseif result==false then
                SetStatus("Jagung","Siklus gagal - mencoba ulang")
                task.wait(4)
            else
                SetStatus("Jagung","Siklus selesai! Mengulang...")
                task.wait(2)
            end
        end

        busy=false

        if not alive then return end

        if not running then
            F.Jagung=false
            UpdateToggle("Jagung")
            SetStatus("Jagung","OFF oleh pengguna")
        end
    end)
end

