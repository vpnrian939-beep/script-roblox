local CachedCoinName

local function GetBuyBalance()
    local Leaderstats = Player:FindFirstChild("leaderstats")
    if not Leaderstats then return 0 end

    if not CachedCoinName then
        CachedCoinName = "Koin"

        local ConfigModule =
            ReplicatedStorage:FindFirstChild("GameConfig")

        if ConfigModule then
            local OK,Config = pcall(require,ConfigModule)

            if OK and Config
            and Config.Economy
            and Config.Economy.LeaderstatName then

                CachedCoinName = Config.Economy.LeaderstatName
            end
        end
    end

    local Stat = Leaderstats:FindFirstChild(CachedCoinName)

    return Stat and tonumber(Stat.Value) or 0
end

