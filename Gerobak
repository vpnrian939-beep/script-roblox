local function GetListedIds(Data)
    local Listed = {}

    for _,Item in ipairs(Data.barang or {}) do
        if type(Item) == "table" then
            if Item.id then
                Listed[tostring(Item.id)] = true
            end

            if type(Item.babi) == "table" and Item.babi.id then
                Listed["babi:"..tostring(Item.babi.id)] = true
            end
        end
    end

    return Listed
end

--==================================================
-- PILIH ITEM
--==================================================

local function FindAvailableItem(Grid,Listed,Kind,Data)
    if Kind == "Babi" then
        for _,Pig in ipairs(Data.babiTas or {}) do
            if type(Pig) == "table"
            and Pig.id
            and not Pig.kunci then

                local PigName = "babi:"..tostring(Pig.id)

                if not Listed[PigName] then
                    local Button = Grid:FindFirstChild(PigName)

                    if Button and Button:IsA("GuiButton")
                    and Button.Visible and Button.Active then
                        return Button
                    end
                end
            end
        end

        return nil
    end

    for _,Item in ipairs(Grid:GetChildren()) do
        if Item:IsA("GuiButton")
        and Item.Visible
        and Item.Active
        and Item.Name ~= "ItemTemplate" then

            local IsPig = string.sub(Item.Name,1,5) == "babi:"

            if not IsPig and not Listed[Item.Name] then
                return Item
            end
        end
    end
end

--==================================================
-- TUNGGU SHEET
--==================================================

local function WaitForSheet(Sheet)
    local Started = os.clock()

    repeat
        if Sheet.Visible then
            return true
        end

        task.wait(SPEED.SheetCheck)
    until os.clock() - Started >= SPEED.SheetTimeout

    return Sheet.Visible
end

--==================================================
-- TARUH ITEM
--==================================================

local function TaruhSatu(Data,Kind)
    local Etalase,Sheet = FindLapakUI()

    if not Etalase or not Sheet or not IsEtalaseOpen() then
        return false,"Etalase belum terbuka"
    end

    local Tas = Etalase:FindFirstChild("Tas")
    local Grid = Tas and Tas:FindFirstChild("Grid")

    if not Grid then
        return false,"Grid tas tidak ditemukan"
    end

    local Listed = GetListedIds(Data)
    local Item = FindAvailableItem(Grid,Listed,Kind,Data)

    if not Item then
        return false,"Tidak ada "..Kind.." baru"
    end

    Status.Text = "Memilih "..Kind..": "..Item.Name

    if not ClickButton(Item) then
        return false,"Gagal memilih "..Kind
    end

    if not WaitForSheet(Sheet) then
        return false,"Sheet harga tidak muncul"
    end

    if not AnyRunning() then
        return false,"Proses dihentikan"
    end

    if not IsEtalaseOpen() then
        return false,"Etalase tertutup"
    end

    local BarisHarga = Sheet:FindFirstChild("BarisHarga")
    local KotakHarga = BarisHarga and BarisHarga:FindFirstChild("Kotak")

    if not KotakHarga then
        return false,"Kolom harga tidak ditemukan"
    end

    if Kind == "Babi" then
        KotakHarga.Text = "1"
    else
        local Preset = Sheet:FindFirstChild("Preset")
        local Semua = Preset and Preset:FindFirstChild("Pre3")

        if not Semua then
            return false,"Tombol Semua tidak ditemukan"
        end

        if not ClickButton(Semua) then
            return false,"Gagal memilih preset"
        end

        task.wait(SPEED.AfterPrice)

        if not KotakHarga.Parent then
            return false,"Kolom harga hilang"
        end

        KotakHarga.Text = "1"
    end

    task.wait(SPEED.AfterPrice)

    if not AnyRunning() then
        return false,"Proses dihentikan"
    end

    local OK = Sheet:FindFirstChild("OK")

    if not OK then
        return false,"Tombol Taruh tidak ditemukan"
    end

    Status.Text = "Menaruh "..Kind..": "..Item.Name

    if not ClickButton(OK) then
        return false,"Gagal menekan Taruh"
    end

    task.wait(SPEED.AfterPlace)

    return true
end

--==================================================
-- GEROBAK
--==================================================

local function GetGerobak()
    local Character = Player.Character
    local Backpack = Player:FindFirstChildOfClass("Backpack")

    if not Character or not Backpack then
        return nil
    end

    return Character:FindFirstChild("Gerobak")
        or Backpack:FindFirstChild("Gerobak")
end

local function PrepareGerobak()
    local Character = Player.Character

    if not Character then
        return false,"Karakter tidak ditemukan"
    end

    local Tool = GetGerobak()

    if not Tool then
        return false,"Gerobak tidak ditemukan"
    end

    if Tool.Parent ~= Character then
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")

        if not Humanoid then
            return false,"Humanoid tidak ditemukan"
        end

        Humanoid:EquipTool(Tool)
        task.wait(SPEED.AfterEquip)
    end

    if IsEtalaseOpen() then
        return true
    end

    if os.clock() - LastOpenAttempt < SPEED.ReopenDelay then
        return false,"Menunggu etalase terbuka..."
    end

    LastOpenAttempt = os.clock()
    Status.Text = "Membuka ulang etalase..."

    pcall(function()
        Tool:Activate()
    end)

    local Started = os.clock()

    repeat
        if IsEtalaseOpen() then
            Status.Text = "Etalase terbuka kembali"
            return true
        end

        task.wait(SPEED.ReopenCheck)
    until os.clock() - Started >= 1

    return false,"Etalase belum terbuka, mencoba lagi..."
end

--==================================================
-- MODE AKTIF
--==================================================

local function GetKinds()
    local Kinds = {}

    if F.Babi and F.Bahan then
        if LastKind == "Babi" then
            Kinds = {"Bahan","Babi"}
        else
            Kinds = {"Babi","Bahan"}
        end

    elseif F.Babi then
        Kinds = {"Babi"}

    elseif F.Bahan then
        Kinds = {"Bahan"}
    end

    return Kinds
end

--==================================================
-- WORKER UTAMA
--==================================================

local function AutoLoop()
    while AnyRunning() do
        local Ready,Reason = PrepareGerobak()

        if not Ready then
            Status.Text = Reason
            task.wait(SPEED.Retry)
            continue
        end

        local Data = GetEtalaseData()

        if not Data then
            Status.Text = "Gagal membaca data etalase"
            task.wait(SPEED.DataFail)
            continue
        end

        local Jumlah = #(Data.barang or {})
        local Maks = tonumber(Data.maksJenis) or 9

        if Jumlah >= Maks then
            Status.Text = "Etalase penuh: "..Jumlah.."/"..Maks
            task.wait(SPEED.FullWait)
            continue
        end

        local Kinds = GetKinds()
        local Success = false
        local Message = "Tidak ada item tersedia"

        for _,Kind in ipairs(Kinds) do
            if not AnyRunning() then
                break
            end

            if not IsEtalaseOpen() then
                Message = "Etalase tertutup"
                break
            end

            local Result,Reason2 = TaruhSatu(Data,Kind)

            if Result then
                Success = true
                LastKind = Kind
                break
            else
                Message = Reason2 or Message
            end
        end

        if not Success then
            Status.Text = Message
            task.wait(SPEED.Retry)
        end
    end
end

local function StartWorker()
    if WorkerRunning then return end

    WorkerRunning = true

    task.spawn(function()
        while AnyRunning() do
            local Success,Error = pcall(AutoLoop)

            if not Success then
                Status.Text = "Error: "..tostring(Error)
                task.wait(SPEED.Retry)
            end
        end

        WorkerRunning = false

        if not AnyRunning() then
            Status.Text = "Semua Auto dimatikan"
        end
    end)
end

