local LapakRemote

local function GetLapakRemote()
    if LapakRemote and LapakRemote.Parent then
        return LapakRemote
    end

    local Registry = ReplicatedStorage:FindFirstChild("RemoteRegistry")
    if not Registry then return nil end

    local Success,Module = pcall(require,Registry)
    if not Success or not Module then return nil end

    local Success2,Folder = pcall(function()
        return Module.folder("Remotes")
    end)

    if not Success2 or not Folder then return nil end

    LapakRemote = Folder:FindFirstChild("LapakAksi")
    return LapakRemote
end

local function GetEtalaseData()
    local Remote = GetLapakRemote()
    if not Remote then return nil end

    local Success,Data = pcall(function()
        return Remote:InvokeServer("etalase")
    end)

    if Success and type(Data) == "table" and Data.ok then
        return Data
    end

    return nil
end

