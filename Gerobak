-- AUTO BUY: REFRESH DAGANGAN
--==================================================

local function ReadSeller(UserId)
    local Remote = GetLapakRemote()

    if not Remote then
        return nil
    end

    local OK,Data = pcall(function()
        return Remote:InvokeServer("lihat",UserId)
    end)

    if OK and type(Data) == "table" and Data.ok then
        return Data
    end

    return nil
end

--==================================================
-- AUTO BUY: BELI MAX
--==================================================

local function BuySeller(UserId)
    if not F.Buy then return end

    local Remote = GetLapakRemote()

    if not Remote then
        Status.Text = "Remote lapak tidak ditemukan"
        return
    end

    -- Baca stok terbaru dari server
    local Data = ReadSeller(UserId)

    if not Data then
        Status.Text = "Gagal membaca dagangan: "..tostring(UserId)
        return
    end

    local SellerName = tostring(Data.nama or UserId)
    local Items = Data.barang or {}

    if #Items == 0 then
        Status.Text = "Lapak kosong: "..SellerName
        return
    end

    for _,Item in ipairs(Items) do
        if not F.Buy then break end

        if type(Item) == "table"
        and Item.id
        and tonumber(Item.n)
        and tonumber(Item.harga) then

            local Stock = tonumber(Item.n)
            local Price = tonumber(Item.harga)

            if Stock > 0 and Price > 0 then
                local Balance = GetBuyBalance()

                -- Jumlah pembelian maksimum
                local MaxAmount = math.min(
                    Stock,
                    math.floor(Balance / Price)
                )

                if MaxAmount > 0 then
                    Status.Text =
                        "Beli "..SellerName
                        .." | "..tostring(Item.id)
                        .." x"..MaxAmount

                    local OK,Result = pcall(function()
                        return Remote:InvokeServer(
                            "beli",
                            UserId,
                            Item.id,
                            MaxAmount,
                            Price
                        )
                    end)

                    if OK and type(Result) == "table"
                    and Result.ok then

                        Status.Text =
                            "Berhasil beli "..tostring(Item.id)
                            .." x"..MaxAmount
                    else
                        Status.Text =
                            "Gagal beli: "..tostring(Item.id)
                    end

                    task.wait(SPEED.BuyAfter)
                end
            end
        end
    end
end

--==================================================
-- AUTO BUY: WORKER UTAMA
--==================================================

local function AutoBuyLoop()
    while F.Buy do
        Status.Text = "Memindai lapak pemain..."

        local Lapak = ScanLapak()
        local Count = 0

        for UserId in pairs(Lapak) do
            if not F.Buy then break end

            Count += 1

            Status.Text =
                "Memeriksa lapak "..tostring(UserId)

            local OK,Error = pcall(function()
                BuySeller(UserId)
            end)

            if not OK then
                Status.Text = "Error Auto Buy: "..tostring(Error)
                task.wait(SPEED.BuyError)
            end
        end

        if Count == 0 then
            Status.Text = "Belum ada lapak terdeteksi"
        else
            Status.Text =
                "Scan selesai: "..Count.." lapak | Refresh..."
        end

        -- Scan ulang dan baca ulang stok server
        task.wait(SPEED.BuyRefresh)
    end

    BuyWorkerRunning = false
end

local function StartBuyWorker()
    if BuyWorkerRunning then return end

    BuyWorkerRunning = true

    task.spawn(function()
        while F.Buy do
            local OK,Error = pcall(AutoBuyLoop)

            if not OK then
                Status.Text = "Error Auto Buy: "..tostring(Error)
                task.wait(SPEED.BuyError)
            end
        end

        BuyWorkerRunning = false
    end)
end

