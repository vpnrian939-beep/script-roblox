local function GetPromptOwner(Prompt)
    if not Prompt or Prompt.Name ~= "LihatDagangan" then
        return nil
    end

    local Current = Prompt.Parent

    for _ = 1,6 do
        if not Current then break end

        local Owner = Current:GetAttribute("OwnerUserId")

        if Owner then
            Owner = tonumber(Owner)

            if Owner and Owner ~= Player.UserId then
                return Owner
            end
        end

        Current = Current.Parent
    end

    return nil
end

