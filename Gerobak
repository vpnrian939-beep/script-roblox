local function ScanLapak()
    local Found = {}

    for _,Object in ipairs(workspace:GetDescendants()) do
        if not F.Buy then break end

        if Object:IsA("ProximityPrompt")
        and Object.Name == "LihatDagangan" then

            local Owner = GetPromptOwner(Object)

            if Owner then
                Found[Owner] = true
