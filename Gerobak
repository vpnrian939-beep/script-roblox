-- CEK ETALASE
--==================================================

local function IsEtalaseOpen()
    local Etalase = FindLapakUI()
    if not Etalase then return false end

    local Current = Etalase

    while Current do
        if Current:IsA("GuiObject") and not Current.Visible then
            return false
        end

        if Current:IsA("ScreenGui") and not Current.Enabled then
            return false
        end

        Current = Current.Parent
    end

    return true
end

