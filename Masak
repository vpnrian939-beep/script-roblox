-- DRAG HP
local dragging = false
local dragStart
local startPosition

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPosition = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

-- CARI BABI
local function findPig()
    local character = player.Character

    if character then
        for _,v in ipairs(character:GetChildren()) do
            if v:IsA("Tool") and v.Name:lower():find("babi ngepet") then
                return v
            end
        end
    end

    for _,v in ipairs(backpack:GetChildren()) do
        if v:IsA("Tool") and v.Name:lower():find("babi ngepet") then
            return v
        end
    end
end

-- CARI PANGGANGAN YANG BENAR
local function findGrill()
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "pPangang" then
            local prompt = obj:FindFirstChild("PanggangPrompt", true)

            if prompt and prompt:IsA("ProximityPrompt") then
                return prompt
            end
        end
    end
end

-- POSISI PROMPT
local function getPromptPosition(prompt)
    local parent = prompt.Parent

    if parent:IsA("Attachment") then
        return parent.WorldPosition
    end

    if parent:IsA("BasePart") then
        return parent.Position
    end

    local part = parent:FindFirstChildWhichIsA("BasePart", true)
    if part then
        return part.Position
    end

    return nil
end

-- BERJALAN KE PANGGANGAN
local function walkTo(position, humanoid, root)
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true
    })

    local success = pcall(function()
        path:ComputeAsync(root.Position, position)
    end)

    if success and path.Status == Enum.PathStatus.Success then
        for _,waypoint in ipairs(path:GetWaypoints()) do
            if not autoCook then return false end

            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end

            humanoid:MoveTo(waypoint.Position)

            local reached = humanoid.MoveToFinished:Wait()
            if not reached then
                return false
            end
        end

        return true
    end

    humanoid:MoveTo(position)
    return humanoid.MoveToFinished:Wait()
end

-- PROSES MEMASAK
local function cookLoop()
    if busy then return end
    busy = true

    while autoCook do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root then
            status.Text = "Status: Menunggu karakter"
            task.wait(1)
            continue
        end

        local pig = findPig()

        if not pig then
            status.Text = "Status: Babi tidak ditemukan"
            task.wait(2)
            continue
        end

        if pig.Parent == backpack then
            humanoid:EquipTool(pig)
            task.wait(0.5)
        end

        local prompt = findGrill()

        if not prompt then
            status.Text = "Status: Prompt tidak ditemukan"
            task.wait(2)
            continue
        end

        if not prompt.Enabled then
            status.Text = "Status: Panggangan belum aktif"
            task.wait(1)
            continue
        end

        local position = getPromptPosition(prompt)

        if not position then
            status.Text = "Status: Posisi panggangan gagal"
            task.wait(2)
            continue
        end

        status.Text = "Status: Menuju panggangan..."

        local distance = (root.Position - position).Magnitude

        if distance > prompt.MaxActivationDistance then
            local reached = walkTo(position, humanoid, root)

            if not autoCook then break end

            if not reached then
                status.Text = "Status: Gagal berjalan"
                task.wait(2)
                continue
            end
        end

        if (root.Position - position).Magnitude >
            prompt.MaxActivationDistance then
            status.Text = "Status: Belum cukup dekat"
            task.wait(1)
            continue
        end

        status.Text = "Status: Memasak..."

        local holding = pcall(function()
            prompt:InputHoldBegin()
        end)

        if holding then
            local duration = math.max(prompt.HoldDuration, 0.5)
            local elapsed = 0

            while autoCook and elapsed < duration do
                task.wait(0.1)
                elapsed += 0.1
            end

            pcall(function()
                prompt:InputHoldEnd()
            end)
        else
            status.Text = "Status: Gagal menahan prompt"
            task.wait(2)
        end

        task.wait(1)
    end

    busy = false
    status.Text = "Status: Standby"
end

